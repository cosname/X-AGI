{
  "name": "x-agi-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run validate",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-build.mjs",
    "downloads:manifest": "node scripts/generate-archive-download-manifest.mjs",
    "downloads:verify": "node scripts/verify-archive-downloads.mjs",
    "test:unit": "node --test src/config/edition-status.test.ts src/scripts/connection-field.test.ts",
    "test": "npm run test:unit && npm run check && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "astro": "7.0.7",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  }
}
