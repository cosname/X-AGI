---
import ShareMeta from '../components/ShareMeta.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  shareTitle?: string;
  noIndex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  shareTitle = title,
  noIndex = false,
  bodyClass,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <ShareMeta title={shareTitle} description={description} canonical={canonical} />
    <meta name="theme-color" content="#6752c8" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/2026/brand/favicon.png" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
