---
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from './BaseLayout.astro';
import type { EditionConfig } from '../config/site';
import '../styles/home-2026.css';

interface Props {
  edition: EditionConfig;
  description?: string;
  canonicalPath: string;
  bodyClass?: string;
}

const {
  edition,
  description,
  canonicalPath,
  bodyClass,
} = Astro.props;
const shareTitle = `${edition.titleZh} 交叉智能大会`;
---

<BaseLayout
  title={shareTitle}
  shareTitle={shareTitle}
  description={description ?? edition.description}
  canonicalPath={canonicalPath}
  bodyClass={`edition-site edition-${edition.year}${bodyClass ? ` ${bodyClass}` : ''}`}
>
  <SiteHeader edition={edition} behavior="overlay-scroll" />
  <main id="main-content">
    <slot />
  </main>
</BaseLayout>
