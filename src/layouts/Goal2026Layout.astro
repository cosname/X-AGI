---
import type { EditionPage } from '../config/navigation';
import type { EditionConfig } from '../config/site';
import GoalInnerPageInteractions from '../components/GoalInnerPageInteractions.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/legacy-2025.css';
import '../styles/goal-2026.css';

interface Props {
  edition: EditionConfig;
  activePage?: EditionPage;
  title: string;
  description: string;
  canonicalPath: string;
}

const {
  edition,
  activePage = '',
  title,
  description,
  canonicalPath,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const noIndex = edition.status === 'planning' || edition.path === '/goal';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="X-AGI Conference" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fdf8f1" />
    <link rel="icon" type="image/png" href="/2026/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/2026/brand/mark.png" />
    <link rel="mask-icon" href="/2026/brand/mark.svg" color="#6752c8" />
    <link href="/2025/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/2025/assets/css/style.css?v=20251012" />
  </head>
  <body class="edition-site edition-2026 edition-legacy-2025 edition-goal-2026">
    <SiteHeader edition={edition} activePage={activePage} behavior="overlay-scroll" />

    <slot />

    <footer class="site-footer">
      <div class="container custom-container">
        <p>版权所有 {edition.titleZh}</p>
        <p>联系方式: {edition.contact}</p>
      </div>
    </footer>

    <GoalInnerPageInteractions />
  </body>
</html>
