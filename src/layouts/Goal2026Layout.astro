---
import type { EditionPage } from '../config/navigation';
import type { EditionConfig } from '../config/site';
import GoalInnerPageInteractions from '../components/GoalInnerPageInteractions.astro';
import ShareMeta from '../components/ShareMeta.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/legacy-2025.css';
import '../styles/goal-2026.css';

interface Props {
  edition: EditionConfig;
  activePage?: EditionPage;
  title: string;
  description: string;
  canonicalPath: string;
}

const {
  edition,
  activePage = '',
  title,
  description,
  canonicalPath,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const shareTitle = title.includes(edition.title)
  ? title.replace(edition.title, edition.titleZh)
  : title;
const noIndex = edition.status === 'planning' || edition.path === '/goal';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <ShareMeta title={shareTitle} description={description} canonical={canonical} />
    <meta name="theme-color" content="#fdf8f1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/xagi-connect-logo.png" />
    <link href="/2025/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/2025/assets/css/style.css?v=20251012" />
  </head>
  <body class="edition-site edition-2026 edition-legacy-2025 edition-goal-2026">
    <SiteHeader edition={edition} activePage={activePage} behavior="overlay-scroll" />

    <slot />

    <footer class="site-footer">
      {edition.contact && (
        <a href={`mailto:${edition.contact}`}>{edition.contact}</a>
      )}
    </footer>

    <GoalInnerPageInteractions />
  </body>
</html>
