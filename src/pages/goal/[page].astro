---
import type { GetStaticPaths } from 'astro';
import Goal2026Layout from '../../layouts/Goal2026Layout.astro';
import MastheadPixelField from '../../components/MastheadPixelField.astro';
import LegacyInnerPage from '../../components/legacy/LegacyInnerPage.astro';
import LegacyAbout from '../../components/legacy/LegacyAbout.astro';
import LegacySchedule from '../../components/legacy/LegacySchedule.astro';
import LegacyPoster from '../../components/legacy/LegacyPoster.astro';
import LegacyGuide from '../../components/legacy/LegacyGuide.astro';
import LegacyRegister from '../../components/legacy/LegacyRegister.astro';
import { currentEditionPageCopy, type CurrentEditionInnerPage } from '../../config/edition-status';
import { editionPath, goalDesignEdition } from '../../config/site';

type GoalPage = Exclude<CurrentEditionInnerPage, 'speakers'>;

export const getStaticPaths = (() =>
  (['about', 'schedule', 'poster', 'guide', 'register'] as const satisfies readonly GoalPage[]).map((page) => ({
    params: { page },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: GoalPage };
const copy = currentEditionPageCopy(page, undefined, goalDesignEdition);
---

<Goal2026Layout
  edition={goalDesignEdition}
  activePage={page}
  title={`${copy.label} | ${goalDesignEdition.title} - Goal Preview`}
  description={copy.description}
  canonicalPath={editionPath(goalDesignEdition, page)}
>
  <LegacyInnerPage
    edition={goalDesignEdition}
    title={copy.label}
    status={page === 'register' || page === 'poster' ? copy.status : undefined}
    visual="goal"
  >
    <figure slot="art" class="goal-page-header-art" aria-hidden="true">
      <MastheadPixelField />
    </figure>
    {page === 'about' && <LegacyAbout />}
    {page === 'schedule' && <LegacySchedule />}
    {page === 'poster' && <LegacyPoster />}
    {page === 'guide' && <LegacyGuide />}
    {page === 'register' && <LegacyRegister />}
  </LegacyInnerPage>
</Goal2026Layout>
