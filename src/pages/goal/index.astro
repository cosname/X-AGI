---
import EditionShell from '../../components/EditionShell.astro';
import ConferenceHome from '../../components/ConferenceHome.astro';
import { editionPath, goalDesignEdition } from '../../config/site';
---

<EditionShell
  edition={goalDesignEdition}
  canonicalPath={editionPath(goalDesignEdition)}
  showFooter={false}
  bodyClass="edition-goal-home"
  headerBehavior="overlay-scroll"
>
  <ConferenceHome edition={goalDesignEdition} heroOnly />
</EditionShell>
