---
import type { GetStaticPaths } from 'astro';
import EditionShell from '../../components/EditionShell.astro';
import ConferencePage from '../../components/ConferencePage.astro';
import PlanningPage from '../../components/PlanningPage.astro';
import { currentEditionPageCopy, type CurrentEditionInnerPage } from '../../config/edition-status';
import { editionPath, nextDesignEdition } from '../../config/site';

const conferencePages = ['about', 'schedule', 'poster', 'guide'] as const;

export const getStaticPaths = (() =>
  (['about', 'speakers', 'schedule', 'poster', 'guide', 'register'] as const satisfies readonly CurrentEditionInnerPage[]).map((page) => ({
    params: { page },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: CurrentEditionInnerPage };

if (page === 'speakers') {
  return Astro.redirect(editionPath(nextDesignEdition, 'schedule'), 301);
}

const copy = currentEditionPageCopy(page, undefined, nextDesignEdition);
const isConferencePage = (conferencePages as readonly string[]).includes(page);
---

<EditionShell
  edition={nextDesignEdition}
  activePage={page}
  pageTitle={copy.label}
  description={copy.description}
  canonicalPath={editionPath(nextDesignEdition, page)}
>
  {isConferencePage ? (
    <ConferencePage variant={page as (typeof conferencePages)[number]} />
  ) : (
    <PlanningPage />
  )}
</EditionShell>
