---
import type { GetStaticPaths } from 'astro';
import PublishedInner2026Layout from '../layouts/PublishedInner2026Layout.astro';
import MastheadPixelField from '../components/MastheadPixelField.astro';
import InnerPageShell from '../components/2026/inner/InnerPageShell.astro';
import AboutPageContent from '../components/2026/inner/AboutPageContent.astro';
import SchedulePageContent from '../components/2026/inner/SchedulePageContent.astro';
import PosterPageContent from '../components/2026/inner/PosterPageContent.astro';
import GuidePageContent from '../components/2026/inner/GuidePageContent.astro';
import RegisterPageContent from '../components/2026/inner/RegisterPageContent.astro';
import { currentEditionPageCopy, type CurrentEditionInnerPage } from '../config/edition-status';
import { currentEdition, editionPath } from '../config/site';
import { conference2026 } from '../data/conference2026';

type PublishedPage = Exclude<CurrentEditionInnerPage, 'speakers'>;

export const getStaticPaths = (() =>
  (['about', 'schedule', 'poster', 'guide', 'register'] as const satisfies readonly PublishedPage[]).map((page) => ({
    params: { page },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: PublishedPage };

const copy = currentEditionPageCopy(page);
---

<PublishedInner2026Layout
  edition={currentEdition}
  activePage={page}
  title={`${copy.label} | ${currentEdition.title}`}
  description={copy.description}
  canonicalPath={editionPath(currentEdition, page)}
>
  <InnerPageShell
    edition={currentEdition}
    title={copy.label}
    status={page === 'register' || page === 'poster' ? copy.status : undefined}
    meta={page === 'schedule'
      ? `${conference2026.dates.compact} / ${conference2026.venue.scheduleName}`
      : undefined}
  >
    <figure slot="art" class="goal-page-header-art" aria-hidden="true">
      <MastheadPixelField pointerEffect="ripple" />
    </figure>
    {page === 'about' && <AboutPageContent />}
    {page === 'schedule' && <SchedulePageContent />}
    {page === 'poster' && <PosterPageContent />}
    {page === 'guide' && <GuidePageContent />}
    {page === 'register' && <RegisterPageContent />}
  </InnerPageShell>
</PublishedInner2026Layout>
