---
import EditionShell from '../components/EditionShell.astro';
import ConferenceHome from '../components/ConferenceHome.astro';
import { currentEdition, editionPath } from '../config/site';
---

<EditionShell
  edition={currentEdition}
  canonicalPath={editionPath(currentEdition)}
  description={currentEdition.description}
  bodyClass="edition-goal-home edition-goal-home--published"
  headerBehavior="overlay-scroll"
>
  <ConferenceHome edition={currentEdition} contentMode="published" />
</EditionShell>
