---
import PublishedHome2026Layout from '../layouts/PublishedHome2026Layout.astro';
import PublishedHomeHero from '../components/2026/home/PublishedHomeHero.astro';
import GoalHomeLower from '../components/2026/home/GoalHomeLower.astro';
import { currentEdition, editionPath } from '../config/site';
---

<PublishedHome2026Layout
  edition={currentEdition}
  canonicalPath={editionPath(currentEdition)}
  description={currentEdition.description}
  bodyClass="edition-goal-home edition-goal-home--with-lower"
>
  <PublishedHomeHero edition={currentEdition} />
  <GoalHomeLower />
</PublishedHome2026Layout>
