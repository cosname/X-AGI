---
import MastheadPixelField from './MastheadPixelField.astro';

interface Props {
  eyebrow: string;
  title: string;
  titleLines?: string[];
  summary?: string;
  status?: string;
  connectionField?: boolean;
}

const {
  eyebrow,
  title,
  titleLines,
  summary,
  status,
  connectionField = false,
} = Astro.props;
---

<header
  class:list={[
    'page-masthead',
    connectionField && 'page-masthead--with-art',
  ]}
  data-connection-stage={connectionField ? '' : undefined}
>
  {connectionField && (
    <figure class="page-masthead__media" aria-hidden="true">
      <MastheadPixelField />
    </figure>
  )}

  <div class="page-masthead__content">
    <p class="conference-kicker">{eyebrow}</p>
    <h1 data-connection-anchor={connectionField ? 'title' : undefined}>
      {titleLines ? titleLines.map((line) => <span>{line}</span>) : title}
    </h1>
    {summary && <p class="page-masthead__summary">{summary}</p>}
    {status && (
      <p class="page-masthead__meta">
        <strong>{status}</strong>
      </p>
    )}
  </div>
</header>
