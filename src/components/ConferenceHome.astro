---
import { currentEditionActionPaths } from '../config/edition-status';
import { editionPath, upcomingEdition, type EditionConfig } from '../config/site';
import { conference2026, type ScheduleDay as ScheduleDayData } from '../data/conference2026';
import ConferencePartners from './ConferencePartners.astro';
import ConferencePublishedHome from './ConferencePublishedHome.astro';
import HeroPixelField from './HeroPixelField.astro';
import ScheduleDay from './ScheduleDay.astro';

interface Props {
  edition?: EditionConfig;
  heroOnly?: boolean;
  contentMode?: 'concept' | 'published';
}

const { edition = upcomingEdition, heroOnly = false, contentMode = 'concept' } = Astro.props;
const actions = currentEditionActionPaths(edition);
const badgeHero = edition.skin === 'goal';
---

<div class:list={['conference-home', heroOnly && 'conference-home--hero-only']}>
  <section
    class:list={['conference-hero', badgeHero && 'conference-hero--badge']}
    aria-labelledby="conference-title"
    data-connection-stage
  >
    <div class="conference-hero__art" aria-hidden="true">
      <HeroPixelField
        interactionMode={badgeHero ? 'calm' : 'direct'}
        composition={badgeHero ? 'badge' : 'grove'}
      />
    </div>

    <div class="conference-hero__inner">
      <div class="conference-hero__copy">
        <h1 id="conference-title" data-connection-anchor="title" data-connection-exclusion>
          <span class="conference-hero__year">2026</span>
          <span class="conference-hero__name" data-title-ink>
            <span
              class="conference-hero__wordmark conference-hero__ink"
              data-title-ink-surface
            >X-AGI</span>
            <em
              class="conference-hero__title-zh conference-hero__ink"
              data-title-ink-surface
            >大会</em>
          </span>
        </h1>
        <div class="conference-hero__tagline-axis" data-connection-exclusion>
          <p class="conference-hero__tagline" lang="en">{conference2026.tagline}</p>
        </div>
        <div class="conference-hero__details">
          <p class="conference-hero__meta" data-connection-exclusion>
            <time datetime={conference2026.dates.start}>{conference2026.dates.display}</time>
            <span>{conference2026.venue.name}</span>
          </p>
          <div
            class="conference-hero__actions"
            data-connection-exclusion
            data-hero-action-switcher={badgeHero ? '' : undefined}
          >
            {badgeHero && (
              <span class="conference-hero__action-capsule" aria-hidden="true"></span>
            )}
            <a
              class="conference-hero__register capsule-action"
              href={conference2026.registration.url}
              target="_blank"
              rel="noopener noreferrer"
              data-hero-action-target={badgeHero ? 'register' : undefined}
            >
              立即报名
            </a>
            <a
              class="conference-hero__schedule"
              href={actions.schedule}
              data-hero-action-target={badgeHero ? 'schedule' : undefined}
            >
              大会日程
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {!heroOnly && contentMode === 'published' && (
    <ConferencePublishedHome edition={edition} />
  )}

  {!heroOnly && contentMode === 'concept' && (
    <div class="conference-home__ground">
      <div class="conference-home__horizon" aria-hidden="true"></div>

      <section class="conference-manifesto" aria-labelledby="manifesto-title">
        <h2 id="manifesto-title">
          <span class="conference-manifesto__line">让研究、方法与人</span>
          <span class="conference-manifesto__line">
            <span class="conference-manifesto__phrase">在同一个场域里</span>
            <span class="conference-manifesto__phrase">相遇。</span>
          </span>
        </h2>
        <p>{conference2026.description}</p>
      </section>

      <section class="conference-formats" aria-labelledby="formats-title">
        <header class="conference-formats__header">
          <h2 id="formats-title">大会环节</h2>
        </header>
        <div class="conference-formats__mosaic">
          {conference2026.mechanisms.map((mechanism) => (
            <article>
              <span aria-hidden="true">{mechanism.number}</span>
              <div>
                <h3 lang={mechanism.number === '02' ? 'en' : undefined}>{mechanism.title}</h3>
                <p>{mechanism.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="conference-section conference-section--provenance" aria-labelledby="provenance-title">
        <div class="conference-section__heading">
          <h2 id="provenance-title">关于 X-AGI</h2>
          <a href={editionPath(edition, 'about')}>会议简介</a>
        </div>
        <div class="conference-provenance__body">
          <p>{conference2026.introduction[1]}</p>
          <dl class="conference-provenance__matrix" aria-label="会议学术脉络">
            <div><dt>学术脉络</dt><dd>中国 R 会议 / FAIC / 历届 X-AGI 活动</dd></div>
            <div><dt>交叉方向</dt><dd>统计 / 数据科学 / 人工智能</dd></div>
            <div><dt>聚焦主题</dt><dd>下一代 AI 研究者</dd></div>
          </dl>
        </div>
      </section>

      <section class="conference-section conference-section--schedule" aria-labelledby="home-schedule-title">
        <header class="conference-section__heading conference-section__heading--split">
          <div>
            <h2 id="home-schedule-title">三天会议结构</h2>
            <p>{conference2026.dates.compact} / {conference2026.venue.scheduleName}</p>
          </div>
          <a href={actions.schedule}>大会日程</a>
        </header>
        <div class="schedule-list">
          {conference2026.schedule.map((day, index) => (
            <ScheduleDay day={day as ScheduleDayData} index={index} />
          ))}
        </div>
      </section>

      <section class="conference-poster-callout" aria-labelledby="poster-callout-title">
        <div class="conference-poster-callout__panel">
          <div class="conference-poster-callout__title">
            <p class="conference-kicker">RISING STAR</p>
            <h2 id="poster-callout-title" lang="en">Rising Stars</h2>
          </div>
          <div class="conference-poster-callout__body">
            <p>{conference2026.poster.headline}</p>
            <p class="conference-poster-callout__meta">
              <time datetime={conference2026.poster.deadline.dateTime}>
                {conference2026.poster.deadline.date} {conference2026.poster.deadline.time} 截止
              </time>
              <span>价值 {conference2026.poster.ticket.value} {conference2026.poster.ticket.currency}正式门票</span>
            </p>
            <a class="capsule-action" href={actions.poster}>申请 Rising Stars</a>
          </div>
        </div>
      </section>

      <ConferencePartners titleId="home-partners-title" variant="logos" />

      <section class="conference-update-strip" aria-label="待发布信息">
        <strong>即将发布</strong>
        <p>{conference2026.pending.join(' / ')}</p>
      </section>
    </div>
  )}
</div>

<script>
  const actionSwitchers = document.querySelectorAll<HTMLElement>('[data-hero-action-switcher]');

  actionSwitchers.forEach((switcher) => {
    if (switcher.dataset.actionCapsuleInitialized === 'true') return;
    switcher.dataset.actionCapsuleInitialized = 'true';

    const register = switcher.querySelector<HTMLElement>('[data-hero-action-target="register"]');
    const targets = Array.from(
      switcher.querySelectorAll<HTMLElement>('[data-hero-action-target]'),
    );
    if (!register || targets.length < 2) return;

    let activeTarget = register;

    const syncCapsule = () => {
      const switcherBounds = switcher.getBoundingClientRect();
      const registerBounds = register.getBoundingClientRect();
      const targetBounds = activeTarget.getBoundingClientRect();
      const capsuleX = targetBounds.left - switcherBounds.left
        + (targetBounds.width - registerBounds.width) / 2;

      switcher.style.setProperty('--hero-action-capsule-x', `${capsuleX}px`);
      switcher.style.setProperty(
        '--hero-action-capsule-y',
        `${registerBounds.top - switcherBounds.top}px`,
      );
      switcher.style.setProperty('--hero-action-capsule-width', `${registerBounds.width}px`);
      switcher.style.setProperty('--hero-action-capsule-height', `${registerBounds.height}px`);
    };

    const activate = (target: HTMLElement) => {
      activeTarget = target;
      switcher.dataset.heroActionActive = target.dataset.heroActionTarget ?? 'register';
      syncCapsule();
    };

    targets.forEach((target) => {
      target.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        activate(target);
      });
      target.addEventListener('focus', () => activate(target));
    });

    switcher.addEventListener('pointerleave', () => activate(register));
    switcher.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        if (!switcher.contains(document.activeElement)) activate(register);
      });
    });

    const resizeObserver = new ResizeObserver(syncCapsule);
    resizeObserver.observe(switcher);
    targets.forEach((target) => resizeObserver.observe(target));

    window.requestAnimationFrame(() => {
      activate(register);
      switcher.dataset.actionCapsuleReady = 'true';
    });

    window.addEventListener('pagehide', () => resizeObserver.disconnect(), { once: true });
  });
</script>
