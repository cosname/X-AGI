---
interface Props {
  titleId: string;
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  label: string;
}

const { titleId, eyebrow, title, description, href, label } = Astro.props;
---

<aside class="page-next-step" aria-labelledby={titleId}>
  <div>
    <p class="conference-kicker">{eyebrow}</p>
    <h2 id={titleId}>{title}</h2>
  </div>
  <div class="page-next-step__action">
    <p>{description}</p>
    <a href={href}>{label}</a>
  </div>
</aside>
