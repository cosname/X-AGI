---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { EditionConfig } from '../config/site';
import type { EditionPage } from '../config/navigation';
import type { SiteHeaderBehavior } from '../config/header';

interface Props {
  edition: EditionConfig;
  activePage?: EditionPage;
  pageTitle?: string;
  description?: string;
  canonicalPath: string;
  showFooter?: boolean;
  bodyClass?: string;
  headerBehavior?: SiteHeaderBehavior;
}

const {
  edition,
  activePage = '',
  pageTitle,
  description,
  canonicalPath,
  showFooter = true,
  bodyClass,
  headerBehavior = 'surface',
} = Astro.props;
const title = pageTitle ? `${pageTitle} | ${edition.title}` : edition.title;
---

<BaseLayout
  title={title}
  description={description ?? edition.description}
  canonicalPath={canonicalPath}
  noIndex={edition.status === 'planning' || edition.skin === 'next' || edition.skin === 'goal'}
  bodyClass={`edition-site edition-${edition.year}${bodyClass ? ` ${bodyClass}` : ''}`}
>
  <SiteHeader edition={edition} activePage={activePage} behavior={headerBehavior} />
  <main id="main-content">
    <slot />
  </main>
  {showFooter && <SiteFooter edition={edition} />}
</BaseLayout>
