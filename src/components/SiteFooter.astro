---
import type { EditionConfig } from '../config/site';

interface Props {
  edition: EditionConfig;
}

const { edition } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <strong>X-AGI <span>{edition.year}</span></strong>
      <p>AI conference for the neXt Generation</p>
    </div>
    <div class="site-footer__event">
      {edition.date && <time>{edition.date}</time>}
      {edition.venue && <span>{edition.venue}</span>}
    </div>
    <div class="site-footer__meta">
      <p>© {edition.year} X-AGI Conference</p>
      {edition.contact && <a href={`mailto:${edition.contact}`}>{edition.contact}</a>}
    </div>
  </div>
</footer>
