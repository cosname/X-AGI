---
import { conference2026, type ScheduleDay, type ScheduleSession, type ScheduleTalk } from '../data/conference2026';

const days = conference2026.schedule as readonly ScheduleDay[];

function sessionHeading(session: ScheduleSession) {
  return session.title ? `${session.period} · ${session.title}` : session.period;
}

function speakerLine(talk: ScheduleTalk) {
  return [talk.speaker, talk.affiliation].filter(Boolean).join(' ｜ ');
}
---

<section class="conference-program" aria-label="三天会议日程" data-program>
  <div class="conference-program__tabs" role="tablist" aria-label="按日期筛选">
    <button type="button" class="is-active" data-program-tab="" aria-pressed="true">全部</button>
    {days.map((day) => (
      <button type="button" data-program-tab={day.dateTime} aria-pressed="false">
        {day.date.replace('2026.', '')} {day.weekday}
      </button>
    ))}
  </div>

  {days.map((day) => (
    <div class="conference-program__day" data-program-day={day.dateTime}>
      {day.sessions.map((session) => (
        <article class="conference-program__session" id={session.id} aria-labelledby={`${session.id}-title`}>
          <header class="conference-program__session-head">
            <p>
              <time datetime={day.dateTime}>{day.date}</time>
              <span>{day.weekday}</span>
              {session.venue && <span>{session.venue}</span>}
            </p>
            <h2 id={`${session.id}-title`}>{sessionHeading(session)}</h2>
            <p class="conference-program__chair">
              <span>主席</span>
              {session.chair?.name || ''}
            </p>
          </header>

          {session.notes && session.notes.length > 0 && (
            <ul class="conference-program__notes">
              {session.notes.map((note) => <li>{note}</li>)}
            </ul>
          )}

          {session.talks && session.talks.length > 0 && (
          <div class="conference-program__talks">
            {session.talks.map((talk) => (
              <article class:list={['conference-program__talk', !talk.title && 'conference-program__talk--slot']}>
                <p class="conference-program__time">{talk.time}</p>
                <div>
                  <h3>{talk.title}</h3>
                  <p class="conference-program__speaker">{speakerLine(talk)}</p>
                  {talk.slides && (
                    <a href={talk.slides} target="_blank" rel="noopener noreferrer">Slides</a>
                  )}
                  {talk.abstract && (
                    <div class="conference-program__copy">
                      <h4>摘要</h4>
                      <p>{talk.abstract}</p>
                    </div>
                  )}
                  {talk.bio && (
                    <div class="conference-program__copy">
                      <h4>嘉宾简介</h4>
                      <p>{talk.bio}</p>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
          )}
        </article>
      ))}
    </div>
  ))}
</section>

<script>
  const root = document.querySelector('[data-program]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll('[data-program-tab]'));
    const days = Array.from(root.querySelectorAll('[data-program-day]'));

    const apply = (value: string) => {
      tabs.forEach((tab) => {
        const on = tab.getAttribute('data-program-tab') === value;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      days.forEach((day) => {
        const show = value === '' || day.getAttribute('data-program-day') === value;
        if (day instanceof HTMLElement) day.hidden = !show;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => apply(tab.getAttribute('data-program-tab') ?? ''));
    });
  }
</script>
