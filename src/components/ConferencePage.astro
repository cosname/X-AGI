---
import { currentEditionPageCopy } from '../config/edition-status';
import { upcomingEdition } from '../config/site';
import { conference2026 } from '../data/conference2026';
import AboutOutline from './AboutOutline.astro';
import ConferencePartners from './ConferencePartners.astro';
import ConferenceProgram from './ConferenceProgram.astro';
import PageMasthead from './PageMasthead.astro';
import RisingStars from './RisingStars.astro';
import VenueMaps from './VenueMaps.astro';

const aboutPartnerNav = [
  { id: 'about-organizers', label: '主办单位', organizations: conference2026.organizers },
  { id: 'about-co-organizers', label: '协办单位', organizations: conference2026.coOrganizers },
  { id: 'about-sponsors', label: '赞助单位', organizations: conference2026.sponsors },
].filter((group) => group.organizations.length > 0);

const aboutOutline = [
  { id: 'about-positioning', label: conference2026.positioning },
  { id: 'about-origin', label: '关于 X-AGI' },
  {
    id: 'about-partners',
    label: '组织与合作',
    children: aboutPartnerNav.map(({ id, label }) => ({ id, label })),
  },
];

interface Props {
  variant: 'about' | 'schedule' | 'poster' | 'guide';
}

const { variant } = Astro.props;
const copy = currentEditionPageCopy(variant, conference2026, upcomingEdition);
---

<article class:list={['conference-page', `conference-page--${variant}`]}>
  {variant === 'about' && (
    <>
      <PageMasthead
        eyebrow="ABOUT"
        title={copy.label}
        summary={conference2026.tagline}
        status={copy.status}
        connectionField
      />

      <div class="conference-page__body conference-about">
      <div class="conference-about__layout">
        <AboutOutline items={aboutOutline} />

        <div class="conference-about__document">
          <section class="conference-about__section" id="about-positioning" aria-labelledby="about-positioning-title">
            <header>
              <h2 id="about-positioning-title">{conference2026.positioning}</h2>
              <p class="conference-about__meta">
                <time datetime={conference2026.dates.start}>{conference2026.dates.display}</time>
                <span>{conference2026.venue.name}</span>
                <span>统计 / 数据科学 / 人工智能</span>
              </p>
            </header>
            <p>{conference2026.introduction[0]}</p>
          </section>

          <section class="conference-about__section" id="about-origin" aria-labelledby="about-origin-title">
            <h2 id="about-origin-title">关于 X-AGI</h2>
            <div class="conference-about__copy">
              {conference2026.introduction.slice(1).map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>

          <ConferencePartners titleId="about-partners" variant="profiles" />
        </div>
      </div>
      </div>
    </>
  )}

  {variant === 'schedule' && (
    <>
      <PageMasthead
        eyebrow="PROGRAM"
        title="日程安排"
        summary={`${conference2026.dates.compact} / ${conference2026.venue.scheduleName}`}
        connectionField
      />

      <div class="conference-page__body">
      <ConferenceProgram />
      </div>
    </>
  )}

  {variant === 'poster' && (
    <>
      <PageMasthead
        eyebrow="RISING STARS"
        title={conference2026.poster.title}
        summary={conference2026.poster.headline}
        status={copy.status}
        connectionField
      />

      <RisingStars />
    </>
  )}

  {variant === 'guide' && (
    <>
      <PageMasthead
        eyebrow="VENUE"
        title="参会指南"
        summary={`大会将于${conference2026.dates.display}在${conference2026.venue.name}举行。`}
        status="会场示意图已发布"
        connectionField
      />

      <div class="conference-page__body">
      <dl class="page-facts page-facts--venue" aria-label="会议信息">
        <div>
          <dt>日期</dt>
          <dd>{conference2026.dates.display}</dd>
        </div>
        <div>
          <dt>会场</dt>
          <dd>
            {conference2026.venue.scheduleName}
            <small>{conference2026.venue.nameEn}, Beijing, China</small>
          </dd>
        </div>
      </dl>

      <VenueMaps />

      <section class="conference-page__pending-list" aria-labelledby="guide-pending-title">
        <header>
          <p class="conference-kicker">UPCOMING INFORMATION</p>
          <h2 id="guide-pending-title">即将补充</h2>
        </header>
        <ul>
          <li><span>交通</span><strong>机场、火车站与公共交通路线</strong><small>待发布</small></li>
          <li><span>住宿</span><strong>推荐住宿与预订说明</strong><small>待发布</small></li>
        </ul>
      </section>
      </div>
    </>
  )}
</article>
