---
import { researchPosterById } from '../../data/research-posters';
const { paperId, titleId } = Astro.props;
const poster = researchPosterById.get(paperId);
---

{poster && (
  <a class="paper-preview paper-preview--poster" href={poster.full.src} target="_blank" rel="noopener noreferrer" aria-describedby={titleId}
    data-research-poster>
    <img src={poster.thumbnail.src} width={poster.thumbnail.width} height={poster.thumbnail.height} alt="" loading="lazy" decoding="async" />
    <span>查看海报 <span aria-hidden="true">⤢</span></span>
  </a>
)}

<style is:global>
  .paper-preview {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--goal-purple-deep, #4f3caf);
    text-decoration: none;
  }
  .paper-preview img {
    display: block;
    width: 100%;
    height: 19rem;
    object-fit: contain;
    object-position: left center;
  }
  .paper-preview > span {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .paper-preview:hover > span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .paper-preview:focus-visible {
    outline: 2px solid var(--goal-purple-deep, #4f3caf);
    outline-offset: 3px;
  }
  .paper-preview--poster {
    cursor: zoom-in;
  }
  .paper-preview--poster img {
    object-position: center;
  }
</style>
