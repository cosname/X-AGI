---
import { posterResearchPapers } from '../../../data/poster-research';
import PaperPreview from '../PaperPreview.astro';
import ResearchPosterViewer from '../ResearchPosterViewer.astro';
import ResearchPosterTools from '../ResearchPosterTools.astro';
import '../../../styles/poster-research.css';
---

<section id="poster-research" class="info-card poster-research" aria-labelledby="poster-research-title" data-poster-research>
  <h2 id="poster-research-title" class="card-header">
    <span>报名论文</span>
  </h2>
  <div class="card-body">
    <ResearchPosterTools idPrefix="poster-research" controls="poster-research-list" />

    <ul id="poster-research-list" class="poster-research__list" role="list">
      {posterResearchPapers.map((paper) => (
        <li id={paper.id}>
          <PaperPreview paperId={paper.id} titleId={`${paper.id}-title`} />
          <h3 id={`${paper.id}-title`}>
            {paper.href ? <a href={paper.href} target="_blank" rel="noopener noreferrer">
              <span>{paper.title}</span><span aria-hidden="true">↗</span>
            </a> : <span>{paper.title}</span>}
          </h3>
          <p class="poster-research__metadata">
            <span data-research-name>{paper.applicantName}</span>
            <span data-research-affiliation>{paper.affiliation}</span>
            {paper.venue && <span data-research-venue>{paper.venue}</span>}
          </p>
        </li>
      ))}
    </ul>
    <p class="poster-research__empty" data-research-empty hidden>没有找到匹配的海报，请试试其他关键词或清除筛选。</p>
  </div>
</section>

<ResearchPosterViewer />

<script>
  import '../../../scripts/poster-research';
</script>
