---
import { conference2026 } from '../../../data/conference2026';

const program = conference2026.programPreview;
const programStatus = program.status.replace(/\.+$/, '');
const dayByShortDate = new Map(
  conference2026.schedule.map((day) => [day.date.slice(5), day]),
);

function isPendingChair(name: string) {
  return name === '待确认';
}

function describeTimeSlot(sourceTime: string) {
  const match = sourceTime.match(/^(\d{2})\.(\d{2})(上午|下午)$/u);
  if (!match) {
    return {
      dateLabel: sourceTime,
      id: `schedule-slot-${sourceTime}`,
      period: '',
      shortDate: sourceTime,
    };
  }

  const shortDate = `${match[1]}.${match[2]}`;
  const day = dayByShortDate.get(shortDate);
  const period = match[3];
  return {
    dateLabel: `${Number(match[1])} 月 ${Number(match[2])} 日${day ? ` · ${day.weekday}` : ''}`,
    id: `schedule-${match[1]}${match[2]}-${period === '上午' ? 'am' : 'pm'}`,
    period,
    shortDate,
  };
}

const sessionsByTime = new Map<string, Array<(typeof program.sessions)[number]>>();
for (const session of program.sessions) {
  const sessions = sessionsByTime.get(session.sourceTime) ?? [];
  sessions.push(session);
  sessionsByTime.set(session.sourceTime, sessions);
}

const programGroups = [...sessionsByTime.entries()].map(([sourceTime, sessions]) => ({
  ...describeTimeSlot(sourceTime),
  sessions,
  sourceTime,
}));

const sessionNumbers = new Map(
  program.sessions.map((session, index) => [session, index + 1]),
);
---

<main class="main-content" data-schedule-page>
  <div class="published-inner-container">
    <header class="schedule-intro">
      <p>{conference2026.dates.compact} / {conference2026.venue.scheduleName}</p>
    </header>

    <section class="schedule-confirmed" aria-labelledby="schedule-confirmed-title">
      <header class="schedule-confirmed__header">
        <h2 id="schedule-confirmed-title">大会日程与嘉宾（{programStatus}）</h2>
      </header>

      {programGroups.map((group, groupIndex) => (
        <section
          class="schedule-period-group"
          id={group.id}
          aria-labelledby={`${group.id}-title`}
          data-schedule-nav-label={`${group.shortDate} ${group.period}`}
        >
          <header class="schedule-period-heading">
            <div>
              <p>DAY {String(groupIndex + 1).padStart(2, '0')}</p>
              <h3 id={`${group.id}-title`}>{group.dateLabel}</h3>
            </div>
            <div class="schedule-period-heading__meta">
              <span class="schedule-period-heading__source-time">{group.shortDate} {group.period}</span>
              <strong aria-hidden="true">{group.period}</strong>
              <span>{group.sessions.length} 个专题</span>
            </div>
          </header>

          <div class="schedule-period-cards">
            {group.sessions.map((session) => {
              const sessionNumber = sessionNumbers.get(session) ?? 0;
              const hasPendingChair = session.chairs.some((chair) => isPendingChair(chair.name));
              return (
                <article class="info-card schedule-card schedule-topic-card">
                  <div class="card-header">
                    <span class="schedule-topic-card__number">
                      Session {String(sessionNumber).padStart(2, '0')}
                    </span>
                    <span class="schedule-topic-card__title">{session.title}</span>
                  </div>
                  <div class:list={['session-chair', { 'session-chair--pending': hasPendingChair }]}>
                    {hasPendingChair ? (
                      '主席待确认'
                    ) : (
                      <>
                        <span class="session-chair__label">主席</span>
                        <span class="session-chair__people">
                          {session.chairs.map((chair, chairIndex) => (
                            <>
                              {chairIndex > 0 && (
                                <span class="schedule-person-separator" aria-hidden="true">/</span>
                              )}
                              <span>
                                {chair.name}
                                {chair.affiliation ? ` | ${chair.affiliation}` : ''}
                              </span>
                            </>
                          ))}
                        </span>
                      </>
                    )}
                  </div>
                  <div class="card-body">
                    <div class="session-list">
                      {session.speakers.length > 0 ? (
                        session.speakers.map((speaker) => (
                          <div class="session-item session-item--speaker">
                            <div class="session-speaker">
                              <span class="session-speaker__name">
                                {speaker.name}
                                {speaker.affiliation ? ` | ${speaker.affiliation}` : ''}
                              </span>
                              {speaker.talkTitle && (
                                <p class="session-speaker__talk-title">{speaker.talkTitle}</p>
                              )}
                            </div>
                          </div>
                        ))
                      ) : (
                        <div class="session-item session-item--reserved schedule-topic-card__empty">
                          <div class="session-title">{program.status}</div>
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </section>
  </div>
</main>

<script is:inline>
  {
    const schedulePage = document.querySelector('[data-schedule-page]');
    const header = document.querySelector('.site-header');
    const navigation = header?.querySelector('.site-navigation');
    const panel = navigation?.querySelector('.site-navigation__panel');
    const nav = navigation?.querySelector('nav');
    const toggle = navigation?.querySelector('.site-navigation__toggle');
    const closeControl = navigation?.querySelector('.site-navigation__close');
    const glassGroup = navigation?.querySelector('[data-glass-group]');
    const groups = schedulePage
      ? [...schedulePage.querySelectorAll('[data-schedule-nav-label]')]
      : [];
    const links = nav
      ? [...nav.querySelectorAll('.site-nav a[data-nav-capsule-target]')]
      : [];

    if (
      schedulePage instanceof HTMLElement
      && header instanceof HTMLElement
      && navigation instanceof HTMLElement
      && panel instanceof HTMLElement
      && nav instanceof HTMLElement
      && toggle instanceof HTMLButtonElement
      && closeControl instanceof HTMLButtonElement
      && glassGroup instanceof HTMLElement
      && groups.every((group) => group instanceof HTMLElement)
      && links.every((link) => link instanceof HTMLAnchorElement)
      && groups.length > 0
      && links.length >= groups.length
    ) {
      const periods = groups.map((group) => ({
        element: group,
        id: group.id,
        label: group.dataset.scheduleNavLabel,
      }));
      const originalNavLabel = nav.getAttribute('aria-label');
      const originalGlassDefault = glassGroup.getAttribute('data-glass-default');
      const originalToggle = {
        ariaLabel: toggle.getAttribute('aria-label'),
        text: toggle.textContent,
      };
      const originalCloseLabel = closeControl.getAttribute('aria-label');
      const originalLinks = links.map((link) => ({
        ariaCurrent: link.getAttribute('aria-current'),
        glassTarget: link.getAttribute('data-glass-target'),
        href: link.getAttribute('href'),
        hidden: link.parentElement?.hidden ?? false,
        text: link.textContent,
      }));
      let renderedState = '';
      let scrollFrame = 0;

      const restoreAttribute = (element, name, value) => {
        if (value === null) element.removeAttribute(name);
        else element.setAttribute(name, value);
      };

      const announceNavigationChange = () => {
        window.dispatchEvent(new Event('xagi:navigation-change'));
      };

      const syncImmediateMobileNavigationMode = (mode) => {
        if (!window.matchMedia('(max-width: 47.99rem)').matches) return;
        navigation.removeAttribute('data-open');
        navigation.removeAttribute('data-closing');
        header.removeAttribute('data-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.removeAttribute('aria-hidden');
        toggle.removeAttribute('inert');
        toggle.tabIndex = 0;
        header.dataset.navMode = mode === 'periods' ? 'inline' : 'compact';
        if (mode === 'periods') {
          panel.removeAttribute('aria-hidden');
          panel.removeAttribute('inert');
        } else {
          panel.setAttribute('aria-hidden', 'true');
          panel.setAttribute('inert', '');
        }
      };

      const renderPeriodNavigation = (activeIndex) => {
        const nextState = `periods:${activeIndex}`;
        if (renderedState === nextState) return;
        renderedState = nextState;
        header.dataset.scheduleNav = 'periods';
        syncImmediateMobileNavigationMode('periods');
        nav.setAttribute('aria-label', '大会日程时段');
        const activePeriod = periods[activeIndex];
        toggle.textContent = activePeriod.label;
        toggle.setAttribute('aria-label', `打开日程时段导航，当前${activePeriod.label}`);
        closeControl.setAttribute('aria-label', '收起日程时段导航');
        glassGroup.dataset.glassDefault = activePeriod.id;

        links.forEach((link, index) => {
          const item = periods[index];
          const listItem = link.parentElement;
          if (item) {
            if (listItem) listItem.hidden = false;
            link.textContent = item.label;
            link.setAttribute('href', `#${item.id}`);
            link.dataset.glassTarget = item.id;
            if (index === activeIndex) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          } else if (listItem) {
            listItem.hidden = true;
            link.removeAttribute('aria-current');
          }
        });
        announceNavigationChange();
      };

      const restoreMainNavigation = () => {
        if (renderedState === 'main') return;
        renderedState = 'main';
        delete header.dataset.scheduleNav;
        restoreAttribute(nav, 'aria-label', originalNavLabel);
        restoreAttribute(glassGroup, 'data-glass-default', originalGlassDefault);
        toggle.textContent = originalToggle.text;
        restoreAttribute(toggle, 'aria-label', originalToggle.ariaLabel);
        restoreAttribute(closeControl, 'aria-label', originalCloseLabel);
        links.forEach((link, index) => {
          const original = originalLinks[index];
          link.textContent = original.text;
          restoreAttribute(link, 'href', original.href);
          restoreAttribute(link, 'data-glass-target', original.glassTarget);
          restoreAttribute(link, 'aria-current', original.ariaCurrent);
          if (link.parentElement) link.parentElement.hidden = original.hidden;
        });
        syncImmediateMobileNavigationMode('main');
        announceNavigationChange();
      };

      const syncNavigation = () => {
        scrollFrame = 0;
        const headerBottom = header.getBoundingClientRect().bottom;
        const activationLine = headerBottom + Math.min(44, window.innerHeight * 0.06);
        if (periods[0].element.getBoundingClientRect().top > activationLine) {
          restoreMainNavigation();
          return;
        }

        let activeIndex = 0;
        periods.forEach((period, index) => {
          if (period.element.getBoundingClientRect().top <= activationLine) activeIndex = index;
        });
        renderPeriodNavigation(activeIndex);
      };

      const requestNavigationSync = () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(syncNavigation);
      };

      const toggleLabelObserver = new MutationObserver(() => {
        if (header.dataset.scheduleNav !== 'periods') return;
        const activePeriod = periods.find((period) => period.element.id === glassGroup.dataset.glassDefault);
        if (!activePeriod) return;
        const label = `打开日程时段导航，当前${activePeriod.label}`;
        if (toggle.getAttribute('aria-label') !== label) toggle.setAttribute('aria-label', label);
      });
      toggleLabelObserver.observe(toggle, { attributes: true, attributeFilter: ['aria-label'] });

      window.addEventListener('scroll', requestNavigationSync, { passive: true });
      window.addEventListener('resize', requestNavigationSync, { passive: true });
      window.addEventListener('hashchange', requestNavigationSync);
      window.addEventListener('pageshow', requestNavigationSync);
      nav.addEventListener('click', (event) => {
        const link = event.target instanceof Element
          ? event.target.closest('a[href^="#"]')
          : null;
        if (!(link instanceof HTMLAnchorElement) || header.dataset.scheduleNav !== 'periods') {
          requestNavigationSync();
          return;
        }
        const destination = new URL(link.href, window.location.href);
        const target = destination.hash
          ? document.getElementById(decodeURIComponent(destination.hash.slice(1)))
          : null;
        if (!target) return;
        event.preventDefault();
        window.history.pushState(null, '', destination.hash);
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        requestNavigationSync();
      });
      document.fonts?.ready.then(requestNavigationSync).catch(() => undefined);
      requestNavigationSync();
    }
  }
</script>

<style is:inline>
  .edition-2026-inner .schedule-confirmed__header h2 {
    text-wrap: balance;
  }

  .edition-2026-inner .schedule-confirmed__note {
    max-width: 48rem;
    margin: 0.7rem 0 0;
    color: #686d80;
    line-height: 1.7;
  }

  .site-header[data-schedule-nav='periods'] .site-nav li[hidden] {
    display: none !important;
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-navigation__panel {
    --site-nav-inline-gap: clamp(1.15rem, 2.35vw, 2.65rem);
  }

  .edition-2026 .site-header[data-schedule-nav='periods']
    .site-nav a[aria-current='location'] {
    color: var(--blue);
  }

  @media (max-width: 47.99rem) {
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-header__inner {
      min-height: 4.5rem;
      gap: 0;
      padding-inline: max(0.7rem, calc(var(--page-gutter) - 0.55rem));
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-brand {
      display: none;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__panel,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__compact-glass,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__compact-glass > nav {
      width: 100%;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation {
      margin-left: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__panel {
      --site-nav-inline-gap: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      box-sizing: border-box;
      width: 100%;
      display: grid;
      gap: 0.16rem;
      padding-inline: 0.45rem;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav li {
      min-width: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav a {
      width: 100%;
      min-height: 2.55rem;
      justify-content: center;
      padding-inline: 0.12rem;
      border-bottom: 0;
      border-radius: 999px;
      font-size: clamp(0.7rem, 3.1vw, 0.82rem);
      letter-spacing: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav a[aria-current='location'] {
      color: var(--blue-deep);
      background: var(--glass-micro-fill);
      box-shadow: var(--glass-micro-shadow);
      -webkit-backdrop-filter: var(--glass-micro-backdrop);
      backdrop-filter: var(--glass-micro-backdrop);
    }
  }

  .edition-2026-inner .schedule-period-group {
    scroll-margin-top: calc(var(--site-header-height) + 2.25rem);
  }

  .edition-2026-inner .schedule-period-group + .schedule-period-group {
    margin-top: 3.25rem;
  }

  .edition-2026-inner .schedule-period-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
    padding: 0 0.25rem 0.85rem;
    border-bottom: 1px solid rgb(103 82 200 / 0.25);
  }

  .edition-2026-inner .schedule-period-heading p {
    margin: 0 0 0.25rem;
    color: #6752c8;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.13em;
  }

  .edition-2026-inner .schedule-period-heading h3 {
