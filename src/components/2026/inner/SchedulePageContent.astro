---
import { conference2026 } from '../../../data/conference2026';
import { conference2026PersonForName } from '../../../data/conference2026-people.ts';
import SchedulePersonProfile from './SchedulePersonProfile.astro';

const program = conference2026.programPreview;
const weekdayByShortDate = new Map(
  conference2026.schedule.map((day) => [day.date.slice(5), day.weekday]),
);

function isPendingChair(name: string) {
  return name === '待确认';
}

function describeTimeSlot(sourceTime: string) {
  const match = sourceTime.match(/^(\d{2})\.(\d{2})(上午|下午)$/u);
  if (!match) {
    return {
      dateLabel: sourceTime,
      id: `schedule-slot-${sourceTime}`,
      period: '',
      shortDate: sourceTime,
    };
  }

  const shortDate = `${match[1]}.${match[2]}`;
  const weekday = weekdayByShortDate.get(shortDate);
  const period = match[3];
  return {
    dateLabel: `${Number(match[1])} 月 ${Number(match[2])} 日${weekday ? ` · ${weekday}` : ''} · ${period}`,
    id: `schedule-${match[1]}${match[2]}-${period === '上午' ? 'am' : 'pm'}`,
    period,
    shortDate,
  };
}

const sessionsByTime = new Map<string, Array<(typeof program.sessions)[number]>>();
for (const session of program.sessions) {
  const sessions = sessionsByTime.get(session.sourceTime) ?? [];
  sessions.push(session);
  sessionsByTime.set(session.sourceTime, sessions);
}

const programGroups = [...sessionsByTime.entries()].map(([sourceTime, sessions]) => ({
  ...describeTimeSlot(sourceTime),
  sessions,
  sourceTime,
}));

const sessionNumbers = new Map(
  program.sessions.map((session, index) => [session, index + 1]),
);
---

<main class="main-content" data-schedule-page>
  <div class="published-inner-container">
    <section class="schedule-confirmed" aria-label="大会日程与嘉宾">
      {programGroups.map((group) => (
        <section
          class="schedule-period-group"
          id={group.id}
          aria-labelledby={`${group.id}-title`}
          data-schedule-nav-label={`${group.shortDate} ${group.period}`}
        >
          <header class="schedule-period-heading">
            <h3 id={`${group.id}-title`}>{group.dateLabel}</h3>
          </header>

          <div class="schedule-period-cards">
            {group.sessions.map((session) => {
              const sessionNumber = sessionNumbers.get(session) ?? 0;
              const sessionLabel = `Session ${String(sessionNumber).padStart(2, '0')}`;
              const hasPendingChair = session.chairs.some((chair) => isPendingChair(chair.name));
              const hasSessionProfiles = [...session.chairs, ...session.speakers]
                .some((scheduledPerson) => Boolean(conference2026PersonForName(scheduledPerson.name)));
              return (
                <article
                  class="info-card schedule-card schedule-topic-card"
                  id={`schedule-session-${String(sessionNumber).padStart(2, '0')}`}
                  data-schedule-session-card
                >
                  <div class="card-header">
                    <span class="schedule-topic-card__heading">
                      <span class="schedule-topic-card__number">{sessionLabel}</span>
                      <span class="schedule-topic-card__title">{session.title}</span>
                    </span>
                    <button
                      class="schedule-session-profiles-toggle"
                      type="button"
                      aria-expanded="false"
                      aria-label={hasSessionProfiles
                        ? `展开 ${sessionLabel} 全部嘉宾资料`
                        : `${sessionLabel} 暂无可展开嘉宾资料`}
                      data-schedule-session-profiles-toggle
                      data-session-label={sessionLabel}
                      disabled={!hasSessionProfiles}
                    >
                      <span data-session-profiles-toggle-action>展开</span>
                      <span>全部</span>
                    </button>
                  </div>
                  <section
                    class:list={['session-chair', { 'session-chair--pending': hasPendingChair }]}
                    aria-label="Chair"
                    data-schedule-chair-card
                  >
                    {hasPendingChair ? (
                      <div class="session-chair__person-row">
                        <span class="session-chair__label">Chair</span>
                        <span class="session-chair__person session-chair__person--pending">待确认</span>
                      </div>
                    ) : (
                      session.chairs.map((chair, chairIndex) => {
                        const person = conference2026PersonForName(chair.name);
                        return person ? (
                          <SchedulePersonProfile
                            person={person}
                            displayName={chair.name}
                            displayAffiliation={chair.affiliation}
                            disclosureId={`schedule-person-${String(sessionNumber).padStart(2, '0')}-chair-${person.id}-${chairIndex + 1}`}
                            role="chair"
                            showRoleLabel={chairIndex === 0}
                          />
                        ) : (
                          <div class="session-chair__person-row">
                            <span
                              class="session-chair__label"
                              aria-hidden={chairIndex > 0 ? 'true' : undefined}
                            >
                              {chairIndex === 0 ? 'Chair' : ''}
                            </span>
                            <span class="session-chair__person schedule-person-identity">
                              <strong>{chair.name}</strong>
                              {chair.affiliation && (
                                <span class="schedule-person-identity__affiliation">
                                  <span class="schedule-person-identity__affiliation-text">
                                    {chair.affiliation}
                                  </span>
                                </span>
                              )}
                            </span>
                          </div>
                        );
                      })
                    )}
                  </section>
                  <div class="card-body">
                    <div class="session-list">
                      {session.speakers.length > 0 ? (
                        session.speakers.map((speaker, speakerIndex) => {
                          const person = conference2026PersonForName(speaker.name);
                          return (
                            <div class="session-item session-item--speaker">
                              <div class="session-speaker">
                                {speaker.talkTitle && (
                                  <p class="session-speaker__talk-title">{speaker.talkTitle}</p>
                                )}
                                {person ? (
                                  <SchedulePersonProfile
                                    person={person}
                                    displayName={speaker.name}
                                    displayAffiliation={speaker.affiliation}
                                    disclosureId={`schedule-person-${String(sessionNumber).padStart(2, '0')}-speaker-${person.id}-${speakerIndex + 1}`}
                                    role="speaker"
                                    defaultOpen={session.title.trim().toLowerCase() === 'keynote'}
                                  />
                                ) : (
                                  <span class="session-speaker__name schedule-person-identity">
                                    <strong>{speaker.name}</strong>
                                    {speaker.affiliation && (
                                      <span class="schedule-person-identity__affiliation">
                                        <span class="schedule-person-identity__affiliation-text">
                                          {speaker.affiliation}
                                        </span>
                                      </span>
                                    )}
                                  </span>
                                )}
                              </div>
                            </div>
                          );
                        })
                      ) : (
                        <div class="session-item session-item--reserved schedule-topic-card__empty">
                          <div class="session-title">{program.status}</div>
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </section>
  </div>
</main>

<script is:inline>
  {
    const schedulePage = document.querySelector('[data-schedule-page]');
    const header = document.querySelector('.site-header');
    const navigation = header?.querySelector('.site-navigation');
    const panel = navigation?.querySelector('.site-navigation__panel');
    const nav = navigation?.querySelector('nav');
    const toggle = navigation?.querySelector('.site-navigation__toggle');
    const closeControl = navigation?.querySelector('.site-navigation__close');
    const glassGroup = navigation?.querySelector('[data-glass-group]');
    const groups = schedulePage
      ? [...schedulePage.querySelectorAll('[data-schedule-nav-label]')]
      : [];
    const links = nav
      ? [...nav.querySelectorAll('.site-nav a[data-nav-capsule-target]')]
      : [];
    let requestNavigationSync = () => undefined;

    const elementForHash = (hash) => {
      if (!hash) return null;
      try {
        return document.getElementById(decodeURIComponent(hash.slice(1)));
      } catch {
        return null;
      }
    };

    const sessionCards = schedulePage instanceof HTMLElement
      ? [...schedulePage.querySelectorAll('[data-schedule-session-card]')]
          .filter((card) => card instanceof HTMLElement)
      : [];

    for (const sessionCard of sessionCards) {
      const profiles = [...sessionCard.querySelectorAll('[data-schedule-person-profile]')]
        .filter((profile) => profile instanceof HTMLDetailsElement);
      const sessionToggle = sessionCard.querySelector('[data-schedule-session-profiles-toggle]');
      const actionLabel = sessionToggle?.querySelector('[data-session-profiles-toggle-action]');

      const syncSessionToggle = () => {
        if (!(sessionToggle instanceof HTMLButtonElement)) return;
        const sessionLabel = sessionToggle.dataset.sessionLabel ?? '当前 Session';
        if (profiles.length === 0) {
          sessionToggle.disabled = true;
          sessionToggle.setAttribute('aria-expanded', 'false');
          sessionToggle.setAttribute('aria-label', `${sessionLabel} 暂无可展开嘉宾资料`);
          return;
        }
        const allOpen = profiles.every((profile) => profile.open);
        if (actionLabel instanceof HTMLElement) {
          actionLabel.textContent = allOpen ? '收起' : '展开';
        }
        sessionToggle.setAttribute('aria-expanded', String(allOpen));
        sessionToggle.setAttribute(
          'aria-label',
          `${allOpen ? '收起' : '展开'} ${sessionLabel} 全部嘉宾资料`,
        );
        sessionToggle.disabled = false;
      };

      if (sessionToggle instanceof HTMLButtonElement) {
        sessionToggle.addEventListener('click', () => {
          const shouldOpen = !profiles.every((profile) => profile.open);
          for (const profile of profiles) profile.open = shouldOpen;
          syncSessionToggle();
          requestNavigationSync();
        });
      }

      for (const profile of profiles) {
        profile.addEventListener('toggle', () => {
          syncSessionToggle();
          requestNavigationSync();
        });
      }

      syncSessionToggle();
    }

    const openProfileHashTarget = () => {
      const target = elementForHash(window.location.hash);
      if (!(target instanceof HTMLDetailsElement) || !target.matches('[data-schedule-person-profile]')) {
        return;
      }
      target.open = true;
      window.requestAnimationFrame(requestNavigationSync);
    };
    window.addEventListener('hashchange', openProfileHashTarget);

    if (
      schedulePage instanceof HTMLElement
      && header instanceof HTMLElement
      && navigation instanceof HTMLElement
      && panel instanceof HTMLElement
      && nav instanceof HTMLElement
      && toggle instanceof HTMLButtonElement
      && closeControl instanceof HTMLButtonElement
      && glassGroup instanceof HTMLElement
      && groups.every((group) => group instanceof HTMLElement)
      && links.every((link) => link instanceof HTMLAnchorElement)
      && groups.length > 0
      && links.length >= groups.length
    ) {
      const periods = groups.map((group) => ({
        element: group,
        id: group.id,
        label: group.dataset.scheduleNavLabel,
      }));
      const originalNavLabel = nav.getAttribute('aria-label');
      const originalGlassDefault = glassGroup.getAttribute('data-glass-default');
      const originalToggle = {
        ariaLabel: toggle.getAttribute('aria-label'),
        text: toggle.textContent,
      };
      const originalCloseLabel = closeControl.getAttribute('aria-label');
      const originalLinks = links.map((link) => ({
        ariaCurrent: link.getAttribute('aria-current'),
        glassTarget: link.getAttribute('data-glass-target'),
        href: link.getAttribute('href'),
        hidden: link.parentElement?.hidden ?? false,
        text: link.textContent,
      }));
      const phoneNavigation = window.matchMedia('(max-width: 47.99rem)');
      const activeTouchPointers = new Set();
      let renderedState = '';
      let scrollFrame = 0;
      let menuActivationGuardTimer = 0;

      const restoreAttribute = (element, name, value) => {
        if (value === null) element.removeAttribute(name);
        else element.setAttribute(name, value);
      };

      const announceNavigationChange = () => {
        window.dispatchEvent(new Event('xagi:navigation-change'));
      };

      const clearMobileMenuActivationGuard = () => {
        if (menuActivationGuardTimer) window.clearTimeout(menuActivationGuardTimer);
        menuActivationGuardTimer = 0;
        delete header.dataset.menuActivationGuard;
      };

      const armMobileMenuActivationGuard = () => {
        if (!phoneNavigation.matches) {
          clearMobileMenuActivationGuard();
          return;
        }
        if (menuActivationGuardTimer) window.clearTimeout(menuActivationGuardTimer);
        header.dataset.menuActivationGuard = 'true';
        menuActivationGuardTimer = window.setTimeout(() => {
          menuActivationGuardTimer = 0;
          if (activeTouchPointers.size > 0) {
            armMobileMenuActivationGuard();
            return;
          }
          delete header.dataset.menuActivationGuard;
        }, 480);
      };

      const lockNavModeTransition = () => {
        header.dataset.navTransition = 'none';
      };

      const unlockNavModeTransition = () => {
        void header.offsetWidth;
        window.requestAnimationFrame(() => {
          if (header.dataset.navTransition === 'none') delete header.dataset.navTransition;
        });
      };

      const blockGuardedMenuActivation = (event) => {
        if (!header.hasAttribute('data-menu-activation-guard')) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        delete toggle.dataset.pointerFocus;
      };

      const syncImmediateMobileNavigationMode = (mode) => {
        if (!phoneNavigation.matches) return;
        lockNavModeTransition();
        navigation.removeAttribute('data-open');
        navigation.removeAttribute('data-closing');
        header.removeAttribute('data-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.removeAttribute('aria-hidden');
        toggle.removeAttribute('inert');
        toggle.tabIndex = 0;
        header.dataset.navMode = mode === 'periods' ? 'inline' : 'compact';
        if (mode === 'periods') {
          clearMobileMenuActivationGuard();
          panel.removeAttribute('aria-hidden');
          panel.removeAttribute('inert');
        } else {
          panel.setAttribute('aria-hidden', 'true');
          panel.setAttribute('inert', '');
        }
        unlockNavModeTransition();
      };

      const renderPeriodNavigation = (activeIndex) => {
        const nextState = `periods:${activeIndex}`;
        if (renderedState === nextState) return;
        renderedState = nextState;
        header.dataset.scheduleNav = 'periods';
        syncImmediateMobileNavigationMode('periods');
        nav.setAttribute('aria-label', '大会日程时段');
        const activePeriod = periods[activeIndex];
        toggle.textContent = activePeriod.label;
        toggle.setAttribute('aria-label', `打开日程时段导航，当前${activePeriod.label}`);
        closeControl.setAttribute('aria-label', '收起日程时段导航');
        glassGroup.dataset.glassDefault = activePeriod.id;

        links.forEach((link, index) => {
          const item = periods[index];
          const listItem = link.parentElement;
          if (item) {
            if (listItem) listItem.hidden = false;
            link.textContent = item.label;
            link.setAttribute('href', `#${item.id}`);
            link.dataset.glassTarget = item.id;
            if (index === activeIndex) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          } else if (listItem) {
            listItem.hidden = true;
            link.removeAttribute('aria-current');
          }
        });
        announceNavigationChange();
      };

      const restoreMainNavigation = () => {
        if (renderedState === 'main') return;
        const wasPeriodNavigation = renderedState.startsWith('periods:');
        renderedState = 'main';
        syncImmediateMobileNavigationMode('main');
        delete header.dataset.scheduleNav;
        restoreAttribute(nav, 'aria-label', originalNavLabel);
        restoreAttribute(glassGroup, 'data-glass-default', originalGlassDefault);
        toggle.textContent = originalToggle.text;
        restoreAttribute(toggle, 'aria-label', originalToggle.ariaLabel);
        restoreAttribute(closeControl, 'aria-label', originalCloseLabel);
        links.forEach((link, index) => {
          const original = originalLinks[index];
          link.textContent = original.text;
          restoreAttribute(link, 'href', original.href);
          restoreAttribute(link, 'data-glass-target', original.glassTarget);
          restoreAttribute(link, 'aria-current', original.ariaCurrent);
          if (link.parentElement) link.parentElement.hidden = original.hidden;
        });
        if (wasPeriodNavigation) armMobileMenuActivationGuard();
        announceNavigationChange();
      };

      const syncNavigation = () => {
        scrollFrame = 0;
        const headerBottom = header.getBoundingClientRect().bottom;
        const activationLine = headerBottom + Math.min(44, window.innerHeight * 0.06);
        if (periods[0].element.getBoundingClientRect().top > activationLine) {
          restoreMainNavigation();
          return;
        }

        let activeIndex = 0;
        periods.forEach((period, index) => {
          if (period.element.getBoundingClientRect().top <= activationLine) activeIndex = index;
        });
        renderPeriodNavigation(activeIndex);
      };

      requestNavigationSync = () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(syncNavigation);
      };

      // A lingering iOS tap, including click.detail === 0, can land on the restored menu button.
      toggle.addEventListener('pointerdown', blockGuardedMenuActivation, { capture: true });
      toggle.addEventListener('click', blockGuardedMenuActivation, { capture: true });
      navigation.addEventListener('click', blockGuardedMenuActivation, { capture: true });

      document.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'touch') activeTouchPointers.add(event.pointerId);
      }, { passive: true });
      const finishTouchPointer = (event) => {
        if (event.pointerType !== 'touch') return;
        activeTouchPointers.delete(event.pointerId);
        if (header.hasAttribute('data-menu-activation-guard')) armMobileMenuActivationGuard();
      };
      document.addEventListener('pointerup', finishTouchPointer, { passive: true });
      document.addEventListener('pointercancel', finishTouchPointer, { passive: true });

      const toggleLabelObserver = new MutationObserver(() => {
        if (header.dataset.scheduleNav !== 'periods') return;
        const activePeriod = periods.find((period) => period.element.id === glassGroup.dataset.glassDefault);
        if (!activePeriod) return;
        const label = `打开日程时段导航，当前${activePeriod.label}`;
        if (toggle.getAttribute('aria-label') !== label) toggle.setAttribute('aria-label', label);
      });
      toggleLabelObserver.observe(toggle, { attributes: true, attributeFilter: ['aria-label'] });

      window.addEventListener('scroll', requestNavigationSync, { passive: true });
      window.addEventListener('resize', requestNavigationSync, { passive: true });
      window.addEventListener('hashchange', requestNavigationSync);
      window.addEventListener('pageshow', requestNavigationSync);
      nav.addEventListener('click', (event) => {
        const link = event.target instanceof Element
          ? event.target.closest('a[href^="#"]')
          : null;
        if (!(link instanceof HTMLAnchorElement) || header.dataset.scheduleNav !== 'periods') {
          requestNavigationSync();
          return;
        }
        const destination = new URL(link.href, window.location.href);
        const target = elementForHash(destination.hash);
        if (!target) return;
        event.preventDefault();
        window.history.pushState(null, '', destination.hash);
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        requestNavigationSync();
      });
      document.fonts?.ready.then(requestNavigationSync).catch(() => undefined);
      window.addEventListener('pagehide', clearMobileMenuActivationGuard);
      requestNavigationSync();
    }

    openProfileHashTarget();
  }
</script>

<style is:inline>
  .edition-2026-inner .schedule-confirmed__note {
    max-width: 48rem;
    margin: 0.7rem 0 0;
    color: #686d80;
    line-height: 1.7;
  }

  .site-header[data-schedule-nav='periods'] .site-nav li[hidden] {
    display: none !important;
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-navigation__panel {
    --site-nav-inline-gap: clamp(1.15rem, 2.35vw, 2.65rem);
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-nav__fluid-capsule {
    display: none;
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-navigation__compact-glass > .glass-action-group__lens {
    display: block;
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-navigation__compact-glass[data-glass-scrub] {
    cursor: grab;
  }

  .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
    .site-navigation__compact-glass[data-glass-scrubbing] {
    cursor: grabbing;
  }

  .edition-2026 .site-header[data-schedule-nav='periods']
    .site-nav a[aria-current='location'] {
    color: var(--blue);
  }

  @media (max-width: 47.99rem) {
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-header__inner {
      min-height: 4.5rem;
      gap: 0;
      padding-inline: max(0.7rem, calc(var(--page-gutter) - 0.55rem));
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-brand {
      display: none;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__panel,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__compact-glass,
    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__compact-glass > nav {
      width: 100%;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation {
      margin-left: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__panel {
      --site-nav-inline-gap: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      box-sizing: border-box;
      width: 100%;
      display: grid;
      gap: 0.16rem;
      padding-inline: 0.45rem;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav li {
      min-width: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-nav a {
      width: 100%;
      min-height: 2.55rem;
      justify-content: center;
      padding-inline: 0.12rem;
      border-bottom: 0;
      border-radius: 999px;
      font-size: clamp(0.7rem, 3.1vw, 0.82rem);
      letter-spacing: 0;
    }

    .edition-2026 .site-header[data-schedule-nav='periods'][data-nav-mode='inline']
      .site-navigation__compact-glass:not([data-glass-ready='true'])
      .site-nav a[aria-current='location'] {
      color: var(--blue-deep);
      background: var(--glass-micro-fill);
      box-shadow: var(--glass-micro-shadow);
      -webkit-backdrop-filter: var(--glass-micro-backdrop);
      backdrop-filter: var(--glass-micro-backdrop);
    }
  }

  .edition-2026-inner .schedule-period-group {
    scroll-margin-top: calc(var(--site-header-height) + 2.25rem);
  }

  .edition-2026-inner .schedule-period-group + .schedule-period-group {
    margin-top: 3.25rem;
  }

  .edition-2026-inner .schedule-period-heading {
    margin-bottom: 1rem;
    padding: 0 0.25rem 0.85rem;
    border-bottom: 1px solid rgb(103 82 200 / 0.25);
  }

  .edition-2026-inner .schedule-period-heading h3 {
    margin: 0;
    color: #171a48;
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
