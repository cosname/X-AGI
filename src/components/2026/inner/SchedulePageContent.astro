  }

  .edition-2026-inner .schedule-period-cards .info-card:last-child {
    margin-bottom: 0;
  }

  .edition-goal-2026 .schedule-topic-card .card-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.65rem;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }

  .edition-2026-inner .schedule-topic-card__heading {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.85rem;
  }

  .edition-2026-inner .schedule-topic-card__number {
    flex: 0 0 auto;
    font-size: 0.84rem;
    font-weight: 760;
    letter-spacing: 0.07em;
    opacity: 0.84;
  }

  .edition-2026-inner .schedule-topic-card__title {
    min-width: 0;
    text-wrap: balance;
  }

  .edition-2026-inner .schedule-session-profiles-toggle {
    display: grid;
    position: relative;
    isolation: isolate;
    width: 2.65rem;
    height: 2.65rem;
    box-sizing: border-box;
    place-content: center;
    gap: 0.08rem;
