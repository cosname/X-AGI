---
import { conference2026 } from '../../../data/conference2026';
import { currentEdition, editionPath } from '../../../config/site';
import { isPosterRegistrationOpen } from '../../../config/edition-status';
import PosterResearchDirectory from './PosterResearchDirectory.astro';

const { poster, registration } = conference2026;
---

<main class="main-content">
  <div class="published-inner-container">
    <div id="poster-details" class="info-card">
      <div class="card-header">Rising Stars Poster</div>
      <div class="card-body">
        <p><a href="#poster-research">查看海报 ↓</a></p>
        <dl class="poster-facts">
          <div>
            <dt>截止</dt>
            <dd>
              <time datetime={poster.deadline.dateTime}>
                {poster.deadline.date} {poster.deadline.time}
              </time>
            </dd>
          </div>
          <div>
            <dt>入选权益</dt>
            <dd>
              <ul>
                {poster.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>
              <a href={editionPath(currentEdition, 'travel-grant')}>补助详情</a>
            </dd>
          </div>
          <div>
            <dt>申请要求</dt>
            <dd>
              <ol>
                {poster.requirements.map((requirement) => <li>{requirement}</li>)}
              </ol>
            </dd>
          </div>
        </dl>
        {isPosterRegistrationOpen() && <div class="poster-facts__action">
          <a class="capsule-action" href={registration.url} target="_blank" rel="noopener noreferrer">
            申请 Rising Stars Poster
          </a>
        </div>}
      </div>
    </div>
    <PosterResearchDirectory />
  </div>
</main>

<style>
  #poster-details {
    scroll-margin-top: 6.5rem;
  }
</style>
