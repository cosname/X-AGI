---
import { sessionPosters } from '../../../data/session-posters';
import '../../../styles/goal-session-posters.css';

const filters = [
  { value: 'all', label: '全部专题' },
  { value: '17', label: '10 月 17 日' },
  { value: '18', label: '10 月 18 日' },
];

const posterAlt = (poster: (typeof sessionPosters)[number]) => [
  `X-AGI 2026，专题 ${poster.number}：${poster.title}。${poster.dateLabel}。`,
  poster.chairs.length
    ? `主持人：${poster.chairs.map((chair) => `${chair.name}（${chair.affiliation}）`).join('、')}。`
    : '',
  ...poster.speakers.map((speaker) => (
    `${speaker.name}（${speaker.affiliation || '单位待公布'}）：${speaker.talkTitle || '题目待公布'}。`
  )),
].join('');
---

<section
  class="goal-session-posters"
  id="goal-session-posters"
  aria-labelledby="session-posters-title"
  data-session-poster-gallery
  data-home-speakers
>
  <header class="goal-session-posters__heading">
    <div>
      <p class="goal-session-posters__eyebrow">SPEAKERS</p>
      <h2 id="session-posters-title">演讲嘉宾</h2>
    </div>
    <a class="goal-session-posters__schedule-link" href="/schedule/">
      完整日程 <span aria-hidden="true">↗</span>
    </a>
  </header>

  <div class="goal-session-posters__toolbar">
    <div
      class="goal-session-posters__filters"
      role="group"
      aria-label="按日期筛选专题"
      data-poster-filters
      hidden
    >
      {filters.map((filter) => (
        <button
          type="button"
          aria-pressed={filter.value === 'all'}
          aria-controls="session-posters-viewport"
          data-poster-filter={filter.value}
        >
          {filter.label}
        </button>
      ))}
    </div>
    <p class="goal-session-posters__count" role="status" aria-live="polite" aria-atomic="true" data-poster-count>
      {sessionPosters.length} 个专题
    </p>
  </div>

  <div
    class="goal-session-posters__viewport"
    id="session-posters-viewport"
    role="region"
    aria-label="按专题浏览演讲嘉宾"
    aria-describedby="session-posters-browse-hint"
    tabindex="0"
    data-poster-viewport
  >
    <ol class="goal-session-posters__track" data-poster-track>
      {sessionPosters.map((poster) => (
        <li class="goal-session-posters__card" data-poster-card data-poster-day={poster.day}>
          <a
            class="goal-session-posters__poster-link"
            href={poster.posterSrc}
            data-poster-open
            data-poster-id={poster.id}
            data-poster-title={poster.title}
            data-poster-date={poster.dateLabel}
            data-poster-schedule={poster.href}
          >
            <img
              src={poster.previewSrc}
              alt={posterAlt(poster)}
              width="540"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <div class="goal-session-posters__caption">
              <h3>{poster.title}</h3>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
          <p class="goal-session-posters__speakers">
            <span>嘉宾</span> {poster.speakers.map((speaker) => speaker.name).join(' · ')}
          </p>
        </li>
      ))}
    </ol>
  </div>

  <footer class="goal-session-posters__browse">
    <p id="session-posters-browse-hint">横向浏览全部专题 <span aria-hidden="true">→</span></p>
    <div class="goal-session-posters__arrows" role="group" aria-label="浏览专题海报" data-poster-arrows hidden>
      <button type="button" aria-label="上一个专题" aria-controls="session-posters-viewport" data-poster-previous>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" aria-label="下一个专题" aria-controls="session-posters-viewport" data-poster-next>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </footer>

  <dialog class="goal-session-posters__dialog" id="session-poster-dialog" aria-labelledby="session-poster-dialog-title" data-poster-dialog>
    <header class="goal-session-posters__dialog-heading">
      <div>
        <p data-poster-dialog-date></p>
        <h2 id="session-poster-dialog-title" data-poster-dialog-title>专题海报</h2>
      </div>
      <form method="dialog">
        <button class="goal-session-posters__close" type="submit" aria-label="关闭海报" autofocus>
          <span aria-hidden="true">×</span>
        </button>
      </form>
    </header>
    <div class="goal-session-posters__dialog-image">
      <img alt="" width="1080" height="1440" decoding="async" data-poster-dialog-image />
    </div>
    <footer class="goal-session-posters__dialog-actions">
      <a class="goal-session-posters__download" download data-poster-download>
        下载海报 <span>WEBP</span>
      </a>
      <button type="button" aria-pressed="false" data-poster-zoom>放大阅读</button>
      <a class="goal-session-posters__dialog-schedule" data-poster-dialog-schedule>
        查看日程 <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </dialog>
</section>

<script src="../../../scripts/session-posters.ts"></script>
