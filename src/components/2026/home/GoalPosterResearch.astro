---
import { posterResearchPapers } from '../../../data/poster-research';
import PaperPreview from '../PaperPreview.astro';
import ResearchPosterViewer from '../ResearchPosterViewer.astro';
import ResearchPosterTools from '../ResearchPosterTools.astro';
import '../../../styles/goal-poster-research.css';
---

<section class="goal-poster-research" id="goal-poster-research" aria-labelledby="home-research-title" data-home-research>
  <header class="goal-poster-research__heading">
    <div>
      <p class="goal-poster-research__eyebrow">RISING STARS</p>
      <h2 id="home-research-title">海报展示</h2>
    </div>
    <a class="goal-poster-research__directory" href="/poster/#poster-research">
      全部海报 <span aria-hidden="true">↗</span>
    </a>
  </header>

  <ResearchPosterTools idPrefix="home-research" controls="home-research-viewport" class="goal-poster-research__toolbar" />

  <div class="goal-poster-research__viewport" id="home-research-viewport" role="region" aria-label="海报展示列表" aria-describedby="home-research-hint" tabindex="0" data-home-research-viewport>
    <ul class="goal-poster-research__track" role="list" data-home-research-track>
      {posterResearchPapers.map((paper) => {
        const PaperDetails = paper.href ? 'a' : 'div';
        return (
          <li class="goal-poster-research__card" id={`home-${paper.id}`} data-home-research-card>
            <PaperPreview paperId={paper.id} titleId={`home-${paper.id}-title`} />
            <PaperDetails class="goal-poster-research__paper" href={paper.href || undefined} target={paper.href ? '_blank' : undefined} rel={paper.href ? 'noopener noreferrer' : undefined}>
              {paper.venue && <span class="goal-poster-research__venue" data-home-research-venue>{paper.venue}</span>}
              <h3 id={`home-${paper.id}-title`}>{paper.title}</h3>
              <p class="goal-poster-research__person">
                <span data-home-research-name>{paper.applicantName}</span>
                <span data-home-research-affiliation>{paper.affiliation}</span>
              </p>
              {paper.href && <span class="goal-poster-research__action">阅读论文 <span aria-hidden="true">↗</span></span>}
            </PaperDetails>
          </li>
        );
      })}
    </ul>
  </div>

  <p class="goal-poster-research__empty" data-home-research-empty hidden>没有找到匹配的海报，请试试其他关键词或清除筛选。</p>

  <footer class="goal-poster-research__browse" data-home-research-browse>
    <p id="home-research-hint" class="visually-hidden">可横向浏览海报，或使用左右方向键。</p>
    <div class="goal-poster-research__arrows" role="group" aria-label="浏览展示海报" data-home-research-arrows hidden>
      <button type="button" aria-label="上一张海报" aria-controls="home-research-viewport" data-home-research-previous><span aria-hidden="true">←</span></button>
      <button type="button" aria-label="下一张海报" aria-controls="home-research-viewport" data-home-research-next><span aria-hidden="true">→</span></button>
    </div>
  </footer>
</section>

<ResearchPosterViewer />

<script src="../../../scripts/goal-poster-research.ts"></script>
