---
import { currentEditionActionPaths } from '../../../config/edition-status';
import type { EditionConfig } from '../../../config/site';
import { conference2026 } from '../../../data/conference2026';
import HeroPixelField from '../../HeroPixelField.astro';
import GlassActionGroup from '../../GlassActionGroup.astro';

interface Props {
  edition: EditionConfig;
}

const { edition } = Astro.props;
const actions = currentEditionActionPaths(edition);
---

<div class="conference-home conference-home--hero-only">
  <section
    class="conference-hero conference-hero--badge"
    aria-labelledby="conference-title"
    data-connection-stage
  >
    <div class="conference-hero__art" aria-hidden="true">
      <HeroPixelField interactionMode="calm" composition="badge" />
    </div>

    <div class="conference-hero__inner">
      <div class="conference-hero__copy">
        <h1 id="conference-title" data-connection-anchor="title" data-connection-exclusion data-title-ink>
          <span class="conference-hero__name">
            <span class="conference-hero__year conference-hero__ink" data-title-ink-surface>2026</span>
            <span
              class="conference-hero__wordmark conference-hero__ink conference-hero__ink--mask"
              data-title-ink-surface
              role="img"
              aria-label="X-AGI"
            ></span>
          </span>
          <span
            class="conference-hero__title-zh conference-hero__ink"
            lang="zh-Hans"
            data-title-ink-surface
          >第{conference2026.editionNumber}届{conference2026.nameZhOfficial}</span>
        </h1>
        <div class="conference-hero__tagline-axis" data-connection-exclusion>
          <p class="conference-hero__tagline" lang="en">{conference2026.tagline}</p>
        </div>
        <div class="conference-hero__details">
          <p class="conference-hero__meta" data-connection-exclusion>
            <time datetime={conference2026.dates.start}>{conference2026.dates.display}</time>
            <span>{conference2026.venue.name}</span>
          </p>
          <GlassActionGroup
            class="conference-hero__actions"
            data-connection-exclusion
            data-hero-action-switcher
            defaultTarget="register"
            scrub
            activateOnRelease
            touchScroll="pan-y"
          >
            <a
              class="conference-hero__register capsule-action"
              href={conference2026.registration.url}
              target="_blank"
              rel="noopener noreferrer"
              data-hero-action-target="register"
              data-glass-target="register"
            >
              立即报名
            </a>
            <a
              class="conference-hero__schedule"
              href={actions.schedule}
              data-hero-action-target="schedule"
              data-glass-target="schedule"
            >
              大会日程
            </a>
          </GlassActionGroup>
        </div>
      </div>
    </div>
  </section>
</div>
