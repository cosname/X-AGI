---
import { editionPath, type EditionConfig } from '../../config/site';
import { conference2026 } from '../../data/conference2026';
import GoalHistoryGallery from './GoalHistoryGallery.astro';

interface Props {
  edition: EditionConfig;
}

const { edition } = Astro.props;
const history = conference2026.history;
---

<section class="goal-history" id="goal-history" aria-labelledby="goal-history-title">
  <div class="goal-history__intro">
    <div class="goal-home-lower__section-mark" aria-hidden="true">01</div>
    <header>
      <p class="goal-home-lower__eyebrow">{history.eyebrow}</p>
      <h2 id="goal-history-title">{history.title}</h2>
      <p>{history.summary}</p>
      <a href={editionPath(edition, 'about')}>阅读完整会议简介</a>
    </header>

    <dl class="goal-history__stats" aria-label="大会历史数据">
      {history.stats.map((stat) => (
        <div>
          <dt>{stat.value}</dt>
          <dd>{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>

  <GoalHistoryGallery history={history} />
</section>
