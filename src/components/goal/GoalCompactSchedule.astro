---
import {
  conference2026,
  type ScheduleCategory,
  type ScheduleDay,
  type ScheduleSession,
} from '../../data/conference2026';
import '../../styles/goal-compact-schedule.css';

interface Props {
  scheduleHref: string;
}

const { scheduleHref } = Astro.props;
const program = conference2026.programPreview;
const schedule = conference2026.schedule as readonly ScheduleDay[];
const categoryOptions: readonly { value: ScheduleCategory; label: string }[] = [
  { value: 'arrival', label: '报到' },
  { value: 'keynote', label: '主会场' },
  { value: 'parallel', label: '分会场' },
  { value: 'poster', label: 'Poster' },
];

const categoryLabels: Record<ScheduleCategory, string> = {
  arrival: '报到与交流',
  keynote: '主会场',
  parallel: '分会场',
  poster: 'Poster 展示',
};

const sessionStatuses: Record<ScheduleCategory, string> = {
  arrival: '报到安排已公布',
  keynote: '嘉宾与报告待更新',
  parallel: '专题日期待确认',
  poster: '展示安排已公布',
};

function sessionDescription(session: ScheduleSession) {
  if (session.category === 'parallel') {
    return '专题与嘉宾名单正在持续更新，具体日期、时段与会场以最终日程为准。';
  }
  if (session.category === 'poster') return conference2026.poster.headline;
  if (session.category === 'keynote') return 'Keynote 嘉宾与报告题目将在确认后更新。';
  return '完成报到后，可提前进入 Poster 展区交流。';
}

const sessionCount = schedule.reduce(
  (count, day) => count + day.sessions.length,
  0,
);
---

<section
  class="goal-agenda"
  id="goal-agenda"
  aria-labelledby="goal-agenda-title"
  data-compact-schedule
>
  <div class="goal-agenda__heading">
    <div class="goal-home-lower__section-mark" aria-hidden="true">02</div>
    <header>
      <p class="goal-home-lower__eyebrow">COMPACT PROGRAM</p>
      <h2 id="goal-agenda-title">先找到属于你的那一天</h2>
      <p>日期结构已经公布。专题、嘉宾与具体会场仍在持续更新，展开项目即可查看当前可确认的信息。</p>
    </header>
    <a class="goal-agenda__full-link" href={scheduleHref}>查看完整日程</a>
  </div>

  <div class="goal-agenda__board">
    <div class="goal-agenda__filters">
      <fieldset>
        <legend>日期</legend>
        <div class="goal-agenda__filter-row" data-filter-group="date">
          <button type="button" aria-pressed="true" data-filter-value="all">全部日期</button>
          {schedule.map((day) => (
            <button type="button" aria-pressed="false" data-filter-value={day.dateTime}>
              {day.date.slice(5)} {day.weekday}
            </button>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>场次类型</legend>
        <div class="goal-agenda__filter-row" data-filter-group="category">
          <button type="button" aria-pressed="true" data-filter-value="all">全部类型</button>
          {categoryOptions.map((category) => (
            <button type="button" aria-pressed="false" data-filter-value={category.value}>
              {category.label}
            </button>
          ))}
        </div>
      </fieldset>
    </div>

    <p class="goal-agenda__results" role="status" aria-live="polite" aria-atomic="true" data-schedule-status>
      当前显示 {sessionCount} 项安排
    </p>

    <div class="goal-agenda__list" id="goal-agenda-list" data-schedule-list>
      {schedule.flatMap((day, dayIndex) =>
        day.sessions.map((session, sessionIndex) => (
          <article
            class="goal-agenda__item"
            data-schedule-item
            data-schedule-date={day.dateTime}
            data-schedule-category={session.category}
          >
            <details open={dayIndex === 0 && sessionIndex === 0}>
              <summary>
                <span class="goal-agenda__date">
                  <time datetime={day.dateTime}>{day.date.slice(5)}</time>
                  <small>{day.weekday}</small>
                </span>
                <span class="goal-agenda__time">{session.period}</span>
                <span class="goal-agenda__topic">
                  <strong>{session.title}</strong>
                  <small>{session.venue ?? categoryLabels[session.category]}</small>
                </span>
                <span class="goal-agenda__status">
                  <small>信息状态</small>
                  <span>{sessionStatuses[session.category]}</span>
                </span>
                <span class="goal-agenda__expand" aria-hidden="true">详情</span>
              </summary>

              <div class="goal-agenda__details">
                <p>{sessionDescription(session)}</p>
                {session.notes && session.notes.length > 0 && (
                  <ul>
                    {session.notes.map((note) => <li>{note}</li>)}
                  </ul>
                )}
              </div>
            </details>
          </article>
        ))
      )}
    </div>

    <div class="goal-agenda__empty" hidden data-schedule-empty>
      <strong>当前筛选下暂无项目</strong>
      <p>切换日期或场次类型，查看其他已公布安排。</p>
    </div>

    <footer class="goal-agenda__note">
      <span>{program.status}</span>
      <p>{program.note}</p>
    </footer>
  </div>
</section>
