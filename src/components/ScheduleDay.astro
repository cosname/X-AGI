---
interface Props {
  day: {
    dateTime: string;
    date: string;
    weekday: string;
    segments: readonly {
      slot: string;
      items: readonly string[];
    }[];
  };
  index: number;
  headingLevel?: 2 | 3;
}

const { day, index, headingLevel = 3 } = Astro.props;
---

<article class="schedule-day">
  <header>
    <span>{String(index + 1).padStart(2, '0')}</span>
    {headingLevel === 2 ? (
      <h2 class="schedule-day__title"><time datetime={day.dateTime}>{day.date}</time></h2>
    ) : (
      <h3 class="schedule-day__title"><time datetime={day.dateTime}>{day.date}</time></h3>
    )}
    <small>{day.weekday}</small>
  </header>
  <dl class="schedule-day__segments">
    {day.segments.map((segment) => (
      <div class="schedule-day__segment">
        <dt>{segment.slot}</dt>
        <dd>
          <ul>
            {segment.items.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</article>
