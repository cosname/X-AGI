---
import type { ScheduleDay as ScheduleDayData, ScheduleSession } from '../data/conference2026';

interface Props {
  day: ScheduleDayData;
  index: number;
  headingLevel?: 2 | 3;
}

const { day, index, headingLevel = 3 } = Astro.props;
const sessions = day.sessions as readonly ScheduleSession[];

function sessionLabel(session: ScheduleSession) {
  return session.title ? `${session.period}：${session.title}` : `${session.period}：`;
}

function sessionItems(session: ScheduleSession) {
  const talks = (session.talks ?? []).map((talk) =>
    talk.speaker ? `${talk.speaker} ｜ ${talk.title}` : talk.title,
  );
  return [...(session.notes ?? []), ...talks];
}
---

<article class="schedule-day">
  <header>
    <span>{String(index + 1).padStart(2, '0')}</span>
    {headingLevel === 2 ? (
      <h2 class="schedule-day__title"><time datetime={day.dateTime}>{day.date}</time></h2>
    ) : (
      <h3 class="schedule-day__title"><time datetime={day.dateTime}>{day.date}</time></h3>
    )}
    <small>{day.weekday}</small>
  </header>
  <dl class="schedule-day__segments">
    {sessions.map((session) => (
      <div class="schedule-day__segment">
        <dt>{sessionLabel(session)}</dt>
        <dd>
          <ul>
            {sessionItems(session).map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</article>
