---
import type { EditionConfig } from '../config/site';
import { currentEditionActionPaths } from '../config/edition-status';
import { editionPath } from '../config/site';
import { editionNavigation, type EditionPage } from '../config/navigation';
import type { SiteHeaderBehavior } from '../config/header';
import HeaderScrollState from './HeaderScrollState.astro';

interface Props {
  edition: EditionConfig;
  activePage?: EditionPage;
  behavior?: SiteHeaderBehavior;
}

const { edition, activePage = '', behavior = 'surface' } = Astro.props;
const navigation = editionNavigation(edition);
const actions = currentEditionActionPaths(edition);
const scrollHeader = behavior === 'overlay-scroll';
const capsuleNavigation = edition.skin === 'goal';
---

<header
  class="site-header"
  data-nav-mode="inline"
  data-scroll-header={scrollHeader ? 'true' : undefined}
  data-scroll-state={scrollHeader ? 'top' : undefined}
  data-scroll-threshold={scrollHeader ? '50' : undefined}
  data-nav-capsule={capsuleNavigation ? 'true' : undefined}
>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <div class="site-header__inner">
    <a class="site-brand" href={editionPath(edition)} aria-label={`${edition.titleZh} 首页`}>
      <img
        class="site-brand__mark"
        src="/brand/xagi-connect-logo.png"
        alt=""
        width="112"
        height="112"
        decoding="async"
      />
      <span class="site-brand__year">{edition.year}</span>
    </a>
    <div class="site-navigation">
      <button
        class="site-navigation__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="conference-navigation"
        aria-label="打开会议导航"
      >
        菜单
      </button>
      <div class="site-navigation__panel" id="conference-navigation">
        <div class="site-navigation__atmosphere" aria-hidden="true">
          {
            (
              [
                [72, 8, 4, '#111342'],
                [80, 14, 6, '#6752c8'],
                [88, 8, 3, '#f28a2b'],
                [93, 18, 4, '#8f86bb'],
                [84, 24, 3, '#2c908c'],
                [14, 78, 3, '#6752c8'],
                [78, 68, 5, '#f28a2b'],
                [88, 76, 3, '#111342'],
                [70, 82, 4, '#8f86bb'],
              ] as const
            ).map(([left, top, size, color]) => (
              <i style={`left:${left}%;top:${top}%;width:${size}px;height:${size}px;background:${color}`}></i>
            ))
          }
        </div>
        {capsuleNavigation && (
          <span class="site-nav__fluid-capsule" data-nav-fluid-capsule aria-hidden="true">
            <svg class="site-nav__fluid-outline" data-nav-fluid-outline focusable="false">
              <path class="site-nav__fluid-surface"></path>
              <path class="site-nav__fluid-depth"></path>
              <path class="site-nav__fluid-rim"></path>
              <path class="site-nav__fluid-highlight"></path>
            </svg>
          </span>
        )}
        <nav aria-label={`${edition.year} 会议导航`}>
          <ul class="site-nav">
            {navigation.map((item) => (
              <li>
                <a
                  href={editionPath(edition, item.page)}
                  aria-current={activePage === item.page ? 'page' : undefined}
                  data-nav-capsule-target={capsuleNavigation ? '' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a
          class="site-header__action capsule-action"
          href={actions.register}
          aria-current={activePage === 'register' ? 'page' : undefined}
          data-nav-capsule-target={capsuleNavigation ? '' : undefined}
          data-nav-capsule-default={capsuleNavigation ? '' : undefined}
        >
          立即报名
        </a>
      </div>
    </div>
  </div>
  <script is:inline>
    {
      const header = document.currentScript.parentElement;
      const inner = header?.querySelector('.site-header__inner');
      if (header instanceof HTMLElement && inner instanceof HTMLElement) {
        const phone = window.matchMedia('(max-width: 47.99rem)').matches;
        header.dataset.navMode = phone || inner.scrollWidth > inner.clientWidth + 1
          ? 'compact'
          : 'inline';
      }
    }
  </script>
</header>

{scrollHeader && <HeaderScrollState />}

<script>
  import { capsuleGapMorph } from '../scripts/navigation-capsule';

  const header = document.querySelector<HTMLElement>('.site-header');
  const navigation = header?.querySelector<HTMLElement>('.site-navigation');
  const toggle = navigation?.querySelector<HTMLButtonElement>('.site-navigation__toggle');
  const panel = navigation?.querySelector<HTMLElement>('.site-navigation__panel');
  const inner = header?.querySelector<HTMLElement>('.site-header__inner');
  const navCapsule = panel?.querySelector<HTMLElement>('[data-nav-fluid-capsule]');
  const navCapsuleSvg = navCapsule?.querySelector<SVGSVGElement>('[data-nav-fluid-outline]');
  const navCapsuleOutlines = navCapsuleSvg
    ? [...navCapsuleSvg.querySelectorAll<SVGPathElement>('path')]
    : [];
  const navTargets = panel
    ? [...panel.querySelectorAll<HTMLElement>('[data-nav-capsule-target]')]
    : [];
  const navDefaultTarget = panel?.querySelector<HTMLElement>('[data-nav-capsule-default]') ?? null;
  const phoneNavigation = window.matchMedia('(max-width: 47.99rem)');
  const finePointerNavigation = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedNavigationMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  type CapsuleGeometry = {
    x: number;
    y: number;
    width: number;
    height: number;
    opacity: number;
    neck: number;
  };
  type CapsuleTargetGeometry = {
    element: HTMLElement;
    center: number;
    left: number;
    right: number;
    settleInset: number;
    y: number;
    width: number;
    height: number;
  };
  type CapsuleLayout = {
    railLeft: number;
    targets: CapsuleTargetGeometry[];
  };
  const capsuleState: CapsuleGeometry & { frame: number } = {
    x: 0,
    y: 0,
    width: 0,
    height: 0,
    opacity: 0,
    neck: 0,
    frame: 0,
  };
  const capsuleTarget: CapsuleGeometry = { ...capsuleState };
  let capsuleLayout: CapsuleLayout | null = null;
  let focusedTarget: HTMLElement | null = null;
  let latestPointerX: number | null = null;
  let capsuleIdleTimer = 0;
  let capsulePointerFrame = 0;
  let capsuleLayoutFrame = 0;

  const setLinkScale = (pointerX: number | null) => {
    navTargets.forEach((target) => {
      const geometry = capsuleLayout?.targets.find((candidate) => candidate.element === target);
      if (pointerX === null || !geometry) {
        target.style.removeProperty('--nav-capsule-link-scale');
        return;
      }
      const distance = Math.abs(pointerX - geometry.center);
      const influence = Math.max(0, 1 - distance / Math.max(74, geometry.width * 1.2));
      const eased = influence * influence * (3 - 2 * influence);
      target.style.setProperty('--nav-capsule-link-scale', (1 + eased * 0.052).toFixed(4));
    });
  };

  const capsuleOutlinePath = (
    width: number,
    height: number,
    neck: number,
    inset = 1.1,
  ) => {
    const left = inset;
    const right = Math.max(left + 1, width - inset);
    const top = inset;
    const bottom = Math.max(top + 1, height - inset);
    const radius = Math.max(1, (bottom - top) / 2);
    const middle = (left + right) / 2;
    const lobeEnd = Math.min(middle - 1, Math.max(left + radius, width * 0.27));
    const lobeStart = Math.max(middle + 1, Math.min(right - radius, width * 0.73));
    const bridge = Math.max(2, lobeStart - lobeEnd);
    const waist = Math.min(height * 0.09, 3.4) * neck;
    const control = bridge * 0.22;
    const curve = radius * 0.5522848;

    return [
      `M ${left + radius} ${top}`,
      `H ${lobeEnd}`,
      `C ${lobeEnd + control} ${top} ${middle - control} ${top + waist} ${middle} ${top + waist}`,
      `C ${middle + control} ${top + waist} ${lobeStart - control} ${top} ${lobeStart} ${top}`,
      `H ${right - radius}`,
      `C ${right - radius + curve} ${top} ${right} ${top + radius - curve} ${right} ${top + radius}`,
      `C ${right} ${bottom - radius + curve} ${right - radius + curve} ${bottom} ${right - radius} ${bottom}`,
      `H ${lobeStart}`,
      `C ${lobeStart - control} ${bottom} ${middle + control} ${bottom - waist} ${middle} ${bottom - waist}`,
      `C ${middle - control} ${bottom - waist} ${lobeEnd + control} ${bottom} ${lobeEnd} ${bottom}`,
      `H ${left + radius}`,
      `C ${left + radius - curve} ${bottom} ${left} ${bottom - radius + curve} ${left} ${bottom - radius}`,
      `C ${left} ${top + radius - curve} ${left + radius - curve} ${top} ${left + radius} ${top}`,
      'Z',
    ].join(' ');
  };

  const renderCapsule = () => {
    if (!navCapsule) return;
    navCapsule.style.width = `${capsuleState.width.toFixed(2)}px`;
    navCapsule.style.height = `${capsuleState.height.toFixed(2)}px`;
    navCapsule.style.opacity = capsuleState.opacity.toFixed(3);
    navCapsule.style.setProperty('--nav-capsule-neck', capsuleState.neck.toFixed(4));
    navCapsule.style.transform = `translate3d(${(capsuleState.x - capsuleState.width / 2).toFixed(2)}px, ${(capsuleState.y - capsuleState.height / 2).toFixed(2)}px, 0)`;
    if (navCapsuleSvg && navCapsuleOutlines.length > 0) {
      const outlinePath = capsuleOutlinePath(
        capsuleState.width,
        capsuleState.height,
        capsuleState.neck,
      );
      const glassPath = capsuleOutlinePath(
        capsuleState.width,
        capsuleState.height,
        capsuleState.neck,
        0.08,
      );

      navCapsuleSvg.setAttribute('viewBox', `0 0 ${capsuleState.width.toFixed(2)} ${capsuleState.height.toFixed(2)}`);
      navCapsuleOutlines.forEach((outline) => outline.setAttribute('d', outlinePath));
      navCapsule.style.clipPath = `path("${glassPath}")`;
      navCapsule.style.setProperty('-webkit-clip-path', `path("${glassPath}")`);
      navCapsule.dataset.glassMaterial = 'layered';
    }
  };

  const animateCapsule = () => {
    capsuleState.frame = 0;
    const response = reducedNavigationMotion.matches ? 1 : 0.24;
    capsuleState.x += (capsuleTarget.x - capsuleState.x) * response;
    capsuleState.y += (capsuleTarget.y - capsuleState.y) * response;
    capsuleState.width += (capsuleTarget.width - capsuleState.width) * response;
    capsuleState.height += (capsuleTarget.height - capsuleState.height) * response;
    capsuleState.opacity += (capsuleTarget.opacity - capsuleState.opacity) * (reducedNavigationMotion.matches ? 1 : 0.32);
    capsuleState.neck += (capsuleTarget.neck - capsuleState.neck) * response;
    renderCapsule();

    const difference = Math.max(
      Math.abs(capsuleTarget.x - capsuleState.x),
      Math.abs(capsuleTarget.y - capsuleState.y),
      Math.abs(capsuleTarget.width - capsuleState.width),
      Math.abs(capsuleTarget.height - capsuleState.height),
      Math.abs(capsuleTarget.opacity - capsuleState.opacity) * 100,
      Math.abs(capsuleTarget.neck - capsuleState.neck) * 100,
    );
    if (difference > 0.08) capsuleState.frame = window.requestAnimationFrame(animateCapsule);
  };

  const scheduleCapsule = () => {
    if (!capsuleState.frame) capsuleState.frame = window.requestAnimationFrame(animateCapsule);
  };

  const isCompact = () => header?.dataset.navMode === 'compact';
  const canUseFluidCapsule = () => Boolean(
    header
    && panel
    && navCapsule
    && navDefaultTarget
    && navTargets.length > 0
    && !isCompact()
    && finePointerNavigation.matches,
  );

  const measureCapsuleLayout = () => {
    if (!panel || navTargets.length === 0 || isCompact()) {
      capsuleLayout = null;
      return false;
    }
    setLinkScale(null);
    const railBounds = panel.getBoundingClientRect();
    const targets = navTargets.map((target) => {
      const bounds = target.getBoundingClientRect();
      const isAction = target.hasAttribute('data-nav-capsule-default');
      const settleInset = Math.min(17, Math.max(9, bounds.width * 0.21));
      return {
        element: target,
        center: bounds.left + bounds.width / 2,
        left: bounds.left,
        right: bounds.right,
        settleInset,
        y: bounds.top + bounds.height / 2 - railBounds.top,
        width: bounds.width + (isAction ? 0 : 14),
        height: isAction ? bounds.height : Math.min(bounds.height - 4, 42),
      };
    });
    if (
      railBounds.width <= 0
      || targets.some((target) => target.width <= 0 || target.height <= 0)
    ) {
      capsuleLayout = null;
      return false;
    }
    capsuleLayout = { railLeft: railBounds.left, targets };
    return true;
  };

  const setCapsuleTarget = (pointerX: number, preferredTarget?: HTMLElement) => {
    if (!navCapsule || !canUseFluidCapsule()) return false;
    if (!capsuleLayout && !measureCapsuleLayout()) return false;
    const layout = capsuleLayout;
    if (!layout) return false;
    const { railLeft, targets } = layout;

    let left = targets[0];
    let right = targets[targets.length - 1];
    for (let index = 0; index < targets.length - 1; index += 1) {
      if (pointerX <= targets[index + 1].center) {
        left = targets[index];
        right = targets[index + 1];
        break;
      }
    }
    const centerSpan = Math.max(1, right.center - left.center);
    const centerProgress = Math.max(0, Math.min(1, (pointerX - left.center) / centerSpan));
    const mix = (start: number, end: number, progress = centerProgress) => (
      start + (end - start) * progress
    );
    const hoveredTarget = preferredTarget
      ? targets.find((target) => target.element === preferredTarget)
      : targets.find((target) => (
        pointerX >= target.left + target.settleInset
        && pointerX <= target.right - target.settleInset
      ));
    const gapSpan = Math.max(1, right.left - left.right);
    const gapProgress = Math.max(0, Math.min(1, (pointerX - left.right) / gapSpan));
    const isInGap = !hoveredTarget && pointerX > left.right && pointerX < right.left;
    const gapMorph = isInGap
      ? capsuleGapMorph(left, right, gapProgress)
      : null;
    const width = gapMorph?.width ?? hoveredTarget?.width ?? mix(left.width, right.width);
    const height = gapMorph?.height ?? hoveredTarget?.height ?? mix(left.height, right.height);
    const intendedCenter = hoveredTarget?.center ?? mix(left.center, right.center);
    const unclampedX = intendedCenter - railLeft;

    capsuleTarget.width = width;
    capsuleTarget.height = height;
    capsuleTarget.x = unclampedX;
    capsuleTarget.y = hoveredTarget?.y ?? mix(left.y, right.y);
    capsuleTarget.opacity = 1;
    capsuleTarget.neck = gapMorph?.neck ?? 0;
    navCapsule.dataset.morphState = isInGap ? 'neck' : 'label';
    navCapsule.dataset.morphWeight = capsuleTarget.neck.toFixed(3);

    if (capsuleState.opacity < 0.01) {
      Object.assign(capsuleState, capsuleTarget);
      renderCapsule();
    }
    setLinkScale(intendedCenter);
    scheduleCapsule();
    return true;
  };

  const cancelCapsuleReturn = () => {
    if (!capsuleIdleTimer) return;
    window.clearTimeout(capsuleIdleTimer);
    capsuleIdleTimer = 0;
  };

  const disableFluidCapsule = () => {
    header?.removeAttribute('data-nav-capsule-ready');
    capsuleLayout = null;
    setLinkScale(null);
    if (capsuleState.frame) window.cancelAnimationFrame(capsuleState.frame);
    capsuleState.frame = 0;
    capsuleState.opacity = 0;
    capsuleState.neck = 0;
    capsuleTarget.opacity = 0;
    capsuleTarget.neck = 0;
    renderCapsule();
  };

  const targetCenter = (target: HTMLElement | null) => (
    capsuleLayout?.targets.find((candidate) => candidate.element === target)?.center ?? null
  );

  const reconcileCapsule = (preferredTarget = focusedTarget ?? navDefaultTarget) => {
    if (!canUseFluidCapsule() || !preferredTarget || !measureCapsuleLayout()) {
      disableFluidCapsule();
      return false;
    }
    const center = targetCenter(preferredTarget);
    if (center === null || !setCapsuleTarget(center, preferredTarget)) {
      disableFluidCapsule();
      return false;
    }
    if (header) header.dataset.navCapsuleReady = 'true';
    return true;
  };

  const returnCapsuleToDefault = () => {
    const keyboardTarget = focusedTarget && panel?.contains(document.activeElement)
      ? focusedTarget
      : null;
    const target = keyboardTarget ?? navDefaultTarget;
    const center = targetCenter(target);
    setLinkScale(null);
    if (!target || center === null || !setCapsuleTarget(center, target)) {
      reconcileCapsule(target);
    }
  };

  const scheduleCapsuleReturn = () => {
    cancelCapsuleReturn();
    capsuleIdleTimer = window.setTimeout(() => {
      capsuleIdleTimer = 0;
      returnCapsuleToDefault();
    }, 880);
  };

  const syncPanelAccessibility = () => {
    if (!panel) return;
    if (isCompact() && !navigation?.hasAttribute('data-open')) {
      panel.setAttribute('aria-hidden', 'true');
    } else {
      panel.removeAttribute('aria-hidden');
    }
  };

  const inlineNavigationFits = () => {
    if (!inner) return false;
    setLinkScale(null);
    const previousDisplay = navCapsule?.style.display ?? '';
    if (navCapsule) navCapsule.style.display = 'none';
    const fits = inner.scrollWidth <= inner.clientWidth + 1;
    if (navCapsule) navCapsule.style.display = previousDisplay;
    return fits;
  };

  const syncNavMode = () => {
    if (!header || !inner) return;
    const previous = header.dataset.navMode;
    if (phoneNavigation.matches) {
      header.dataset.navMode = 'compact';
    } else {
      header.dataset.navMode = 'inline';
      if (!inlineNavigationFits()) header.dataset.navMode = 'compact';
    }
    if (previous !== header.dataset.navMode) closeNavigation();
    if (isCompact()) disableFluidCapsule();
    else capsuleLayout = null;
    syncPanelAccessibility();
  };

  const openNavigation = () => {
    if (!navigation || !toggle || !panel || !isCompact()) return;
    navigation.setAttribute('data-open', '');
    header?.setAttribute('data-menu-open', '');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', '收起会议导航');
    toggle.textContent = '收起';
    panel.removeAttribute('aria-hidden');
  };

  const closeNavigation = ({ restoreFocus = false } = {}) => {
    navigation?.removeAttribute('data-open');
    header?.removeAttribute('data-menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', '打开会议导航');
    if (toggle) toggle.textContent = '菜单';
    syncPanelAccessibility();
    if (restoreFocus) toggle?.focus();
  };

  const scheduleHeaderLayoutSync = () => {
    if (capsuleLayoutFrame) return;
    capsuleLayoutFrame = window.requestAnimationFrame(() => {
      capsuleLayoutFrame = 0;
      syncNavMode();
      if (canUseFluidCapsule()) reconcileCapsule();
      else disableFluidCapsule();
    });
  };

  const schedulePointerProcessing = () => {
    if (capsulePointerFrame) return;
    capsulePointerFrame = window.requestAnimationFrame(() => {
      capsulePointerFrame = 0;
      if (latestPointerX === null || focusedTarget || !canUseFluidCapsule()) return;
      if (!capsuleLayout && !measureCapsuleLayout()) {
        disableFluidCapsule();
        return;
      }
      if (setCapsuleTarget(latestPointerX)) {
        if (header) header.dataset.navCapsuleReady = 'true';
        scheduleCapsuleReturn();
      }
    });
  };

  toggle?.addEventListener('click', () => {
    if (navigation?.hasAttribute('data-open')) closeNavigation();
    else openNavigation();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!isCompact() || !navigation?.hasAttribute('data-open')) return;
    event.preventDefault();
    closeNavigation({ restoreFocus: true });
  });

  document.addEventListener('click', (event) => {
    if (
      !isCompact() ||
      !navigation?.hasAttribute('data-open') ||
      navigation.contains(event.target as Node)
    ) return;
    closeNavigation();
  });

  panel?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) {
      closeNavigation();
    }
  });

  panel?.addEventListener('pointermove', (event) => {
    if (event.pointerType === 'touch' || !finePointerNavigation.matches) return;
    latestPointerX = event.clientX;
    schedulePointerProcessing();
  }, { passive: true });
  panel?.addEventListener('pointerleave', () => {
    latestPointerX = null;
    if (capsulePointerFrame) window.cancelAnimationFrame(capsulePointerFrame);
    capsulePointerFrame = 0;
    cancelCapsuleReturn();
    returnCapsuleToDefault();
  }, { passive: true });
  navTargets.forEach((target) => {
    target.addEventListener('focus', () => {
      focusedTarget = target;
      latestPointerX = null;
      cancelCapsuleReturn();
      if (capsulePointerFrame) window.cancelAnimationFrame(capsulePointerFrame);
      capsulePointerFrame = 0;
      const center = targetCenter(target);
      if (center === null || !setCapsuleTarget(center, target)) {
        reconcileCapsule(target);
      }
    });
    target.addEventListener('blur', () => {
      window.queueMicrotask(() => {
        const nextFocusedTarget = navTargets.find((candidate) => candidate === document.activeElement) ?? null;
        focusedTarget = nextFocusedTarget;
        if (nextFocusedTarget) {
          const center = targetCenter(nextFocusedTarget);
          if (center === null || !setCapsuleTarget(center, nextFocusedTarget)) {
            reconcileCapsule(nextFocusedTarget);
          }
          return;
        }
        returnCapsuleToDefault();
      });
    });
  });

  if (inner) {
    const resizeObserver = new ResizeObserver(scheduleHeaderLayoutSync);
    resizeObserver.observe(inner);
  }
  phoneNavigation.addEventListener('change', () => {
    closeNavigation();
    scheduleHeaderLayoutSync();
  });
  finePointerNavigation.addEventListener('change', scheduleHeaderLayoutSync);
  reducedNavigationMotion.addEventListener('change', scheduleHeaderLayoutSync);
  document.fonts?.ready.then(scheduleHeaderLayoutSync).catch(() => undefined);
  document.fonts?.addEventListener('loadingdone', scheduleHeaderLayoutSync);
  window.addEventListener('pagehide', () => {
    closeNavigation();
    latestPointerX = null;
    cancelCapsuleReturn();
    if (capsulePointerFrame) window.cancelAnimationFrame(capsulePointerFrame);
    capsulePointerFrame = 0;
    if (capsuleLayoutFrame) window.cancelAnimationFrame(capsuleLayoutFrame);
    capsuleLayoutFrame = 0;
    disableFluidCapsule();
  });
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    focusedTarget = navTargets.find((candidate) => candidate === document.activeElement) ?? null;
    capsuleLayout = null;
    scheduleHeaderLayoutSync();
  });
  scheduleHeaderLayoutSync();
</script>
