---
import { conference2026 } from '../../data/conference2026';

const program = conference2026.programPreview;
const programStatus = program.status.replace(/\.+$/, '');

function isPendingChair(name: string) {
  return name === '待确认';
}
---

<main class="main-content">
  <div class="container custom-container">
    <header class="schedule-intro">
      <p>{conference2026.dates.compact} / {conference2026.venue.scheduleName}</p>
      <p>{conference2026.scheduleNotice}</p>
    </header>

    <section class="schedule-confirmed" aria-labelledby="schedule-confirmed-title">
      <header class="schedule-confirmed__header">
        <p>SESSIONS &amp; SPEAKERS</p>
        <h2 id="schedule-confirmed-title">大会专题与嘉宾（{programStatus}）</h2>
      </header>

      {program.sessions.map((session, index) => (
        <article class="info-card schedule-card schedule-topic-card">
          <div class="card-header">
            Session {String(index + 1).padStart(2, '0')} | {session.title}
          </div>
          <div class:list={['session-chair', { 'session-chair--pending': isPendingChair(session.chair.name) }]}>
            {isPendingChair(session.chair.name) ? (
              '主持人待确认'
            ) : (
              <>
                主持人 | {session.chair.name}
                {session.chair.affiliation ? ` | ${session.chair.affiliation}` : ''}
              </>
            )}
          </div>
          <div class="card-body">
            <div class="session-list">
              {session.speakers.length > 0 ? (
                session.speakers.map((speaker) => (
                  <div class="session-item session-item--speaker">
                    <div class="session-speaker">
                      <span>
                        {speaker.name}
                        {speaker.affiliation ? ` | ${speaker.affiliation}` : ''}
                      </span>
                    </div>
                  </div>
                ))
              ) : (
                <div class="session-item session-item--reserved schedule-topic-card__empty">
                  <div class="session-title">{program.status}</div>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>
  </div>
</main>
