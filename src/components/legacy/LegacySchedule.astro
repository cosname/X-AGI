---
import ConferenceProgramPreview from '../ConferenceProgramPreview.astro';
import {
  conference2026,
  type ScheduleDay,
  type ScheduleSession,
  type ScheduleTalk,
} from '../../data/conference2026';

function hasPublishedTalk(talk: ScheduleTalk) {
  return Boolean(
    talk.time
    || talk.title
    || talk.speaker
    || talk.affiliation
    || talk.abstract
    || talk.bio
    || talk.slides
  );
}

function visibleNotes(session: ScheduleSession) {
  return session.notes?.filter((note) => note !== session.title) ?? [];
}

const days = (conference2026.schedule as readonly ScheduleDay[]).map((day) => ({
  ...day,
  sessions: day.sessions.map((session) => ({
    ...session,
    publishedTalks: session.talks?.filter(hasPublishedTalk) ?? [],
    visibleNotes: visibleNotes(session),
  })),
}));
---

<main class="main-content">
  <div class="container custom-container">
    <header class="schedule-intro">
      <p>{conference2026.dates.compact} / {conference2026.venue.scheduleName}</p>
      <p>日期框架已经公布，具体时段、报告与会场信息将持续更新。</p>
    </header>

    <ul class="nav nav-pills schedule-tabs mb-4" aria-label="按日期查看日程">
      {days.map((day, index) => (
        <li class="nav-item">
          <button
            class:list={['nav-link', { active: index === 0 }]}
            type="button"
            data-target={`#session-${day.dateTime}`}
          >
            {day.date} {day.weekday}
          </button>
        </li>
      ))}
    </ul>

    {days.map((day) =>
      day.sessions.map((session, sessionIndex) => (
        <article
          class="info-card schedule-card"
          id={sessionIndex === 0 ? `session-${day.dateTime}` : undefined}
        >
          <h2 class="card-header">
            {day.date} {day.weekday} {session.period}
            {session.title ? ` | ${session.title}` : ''}
          </h2>
          {(session.venue || session.chair?.name) && (
            <div class="session-chair">
              {session.venue && <span>会场 | {session.venue}</span>}
              {session.venue && session.chair?.name && <span aria-hidden="true"> · </span>}
              {session.chair?.name && <span>主持人 | {session.chair.name}</span>}
            </div>
          )}
          <div class="card-body">
            {session.visibleNotes.length > 0 && (
              <div class="registration-notes">
                <ul>
                  {session.visibleNotes.map((note) => <li>{note}</li>)}
                </ul>
              </div>
            )}

            {session.publishedTalks.length > 0 && (
              <div class="session-list">
                {session.publishedTalks.map((talk) => (
                  <article class="session-item schedule-talk">
                    {(talk.time || talk.title) && (
                      <h3 class="session-title">
                        {talk.time && <time class="session-time">{talk.time}</time>}
                        {talk.title && <span>{talk.title}</span>}
                      </h3>
                    )}
                    {(talk.speaker || talk.affiliation) && (
                      <p class="session-speaker">
                        {talk.speaker && <strong>{talk.speaker}</strong>}
                        {talk.affiliation && <span>{talk.affiliation}</span>}
                      </p>
                    )}
                    {talk.abstract && (
                      <div class="schedule-talk__detail">
                        <h4>报告摘要</h4>
                        <p>{talk.abstract}</p>
                      </div>
                    )}
                    {talk.bio && (
                      <div class="schedule-talk__detail">
                        <h4>嘉宾简介</h4>
                        <p>{talk.bio}</p>
                      </div>
                    )}
                    {talk.slides && (
                      <a
                        class="schedule-talk__slides"
                        href={talk.slides}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        查看演示文稿
                      </a>
                    )}
                  </article>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    )}

    <ConferenceProgramPreview
      titleId="schedule-program-title"
      className="conference-program-preview--schedule"
    />
  </div>
</main>
