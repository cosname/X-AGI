---
import { currentEditionPageCopy } from '../config/edition-status';
import { upcomingEdition } from '../config/site';
import { conference2026, type TicketBand } from '../data/conference2026';
import MosaicAction from './MosaicAction.astro';
import PageMasthead from './PageMasthead.astro';
import PageNextStep from './PageNextStep.astro';

const copy = currentEditionPageCopy('register', conference2026, upcomingEdition);
const ticketBands = conference2026.tickets.bands as readonly TicketBand[];
---

<article class="conference-page conference-page--holding conference-page--register">
  <PageMasthead
    eyebrow="REGISTRATION"
    title={copy.label}
    summary={conference2026.registration.description}
    status={copy.status}
    connectionField
  />

  <div class="conference-page__body">
  <dl class="page-facts page-facts--registration" aria-label="报名关键信息">
    <div>
      <dt>日期</dt>
      <dd>{conference2026.dates.display}</dd>
    </div>
    <div>
      <dt>地点</dt>
      <dd>{conference2026.venue.scheduleName}</dd>
    </div>
    <div>
      <dt>状态</dt>
      <dd>{conference2026.registration.status}</dd>
    </div>
  </dl>

  <section class="conference-tickets" aria-labelledby="ticket-price-title">
    <header class="conference-tickets__heading">
      <h2 id="ticket-price-title">门票价格</h2>
      <p>单位 {conference2026.tickets.currency}</p>
    </header>

    <div class="conference-tickets__bands">
      {ticketBands.map((band) => (
        <article class="conference-tickets__band">
          <h3>
            {band.label}
            {band.until && <span>{band.until}</span>}
          </h3>
          <div class="conference-tickets__grid" role="table">
            <div class="conference-tickets__row conference-tickets__row--head" role="row">
              <span role="columnheader"></span>
              {conference2026.tickets.columns.map((column) => (
                <span role="columnheader">{column}</span>
              ))}
            </div>
            {band.rows.map((row) => (
              <div class="conference-tickets__row" role="row">
                <span role="rowheader">{row.name}</span>
                <strong role="cell">{row.student}</strong>
                <strong role="cell">{row.general}</strong>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="conference-tickets__notes">
      {conference2026.tickets.notes.map((note) => <p>{note}</p>)}
    </div>
  </section>

  <section class="holding-page__body">
    <div>
      <p class="conference-kicker">REGISTRATION</p>
      <h2>普通参会与 Poster 共用一个入口</h2>
    </div>
    <div class="registration-panel">
      <p>{conference2026.registration.description}</p>
      <ul>
        {conference2026.registration.notes.map((note) => <li>{note}</li>)}
      </ul>
      <MosaicAction href={conference2026.registration.url} target="_blank" rel="noopener noreferrer">
        前往报名系统
      </MosaicAction>
    </div>
  </section>

  <PageNextStep
    titleId="registration-next-step-title"
    eyebrow={copy.next.eyebrow}
    title={copy.next.title}
    description={copy.next.description}
    href={copy.next.href}
    label={copy.next.label}
  />
  </div>
</article>
