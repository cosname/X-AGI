---
import { conference2026, type Organization } from '../data/conference2026';
import { partnerLogoByName } from '../data/legacy-partner-assets';

interface Props {
  titleId: string;
  variant?: 'roster' | 'profiles' | 'logos';
}

const { titleId, variant = 'roster' } = Astro.props;
const allPartnerGroups: { key: string; label: string; organizations: readonly Organization[] }[] = [
  { key: 'initiators', label: '发起方', organizations: conference2026.initiators },
  { key: 'organizers', label: '主办单位', organizations: conference2026.organizers },
  { key: 'co-organizers', label: '协办单位', organizations: conference2026.coOrganizers },
  { key: 'sponsors', label: '赞助伙伴', organizations: conference2026.sponsors },
];
const partnerGroups = allPartnerGroups
  .filter((group) => variant !== 'logos' || group.key !== 'initiators')
  .map((group) => (
    variant === 'logos' && group.key === 'sponsors'
      ? { ...group, label: '赞助单位' }
      : group
  ))
  .filter((group) => group.organizations.length > 0);

---

<section
  class:list={['conference-partners', `conference-partners--${variant}`]}
  aria-labelledby={titleId}
>
  <header class="conference-partners__heading">
    <h2 id={titleId}>
      {variant === 'profiles' ? '组织与合作' : variant === 'logos' ? '组织单位' : '合作伙伴'}
    </h2>
  </header>

  <div class="conference-partners__groups">
    {partnerGroups.map((group, index) => (
      <section
        class="conference-partners__group"
        id={variant === 'profiles' ? `about-${group.key}` : undefined}
        aria-labelledby={`${titleId}-group-${index}`}
      >
        <h3 id={`${titleId}-group-${index}`}>{group.label}</h3>
        {variant === 'profiles' ? (
          <div class="conference-partners__profiles">
            {group.organizations.map((organization) => (
              <article class="conference-partners__profile">
                <h4>
                  {organization.url ? (
                    <a href={organization.url} target="_blank" rel="noopener noreferrer">
                      {organization.name}
                    </a>
                  ) : (
                    organization.name
                  )}
                </h4>
                {organization.intro && (
                  <div class="conference-partners__intro">
                    {organization.intro.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                )}
              </article>
            ))}
          </div>
        ) : variant === 'logos' ? (
          <ul class="conference-partners__logos">
            {group.organizations.map((organization) => {
              const logo = partnerLogoByName[organization.name];
              const content = logo ? (
                <img
                  src={logo.src}
                  alt={organization.name}
                  height="36"
                  loading="lazy"
                  decoding="async"
                  class={logo.className}
                />
              ) : (
                <span class="conference-partners__logo-fallback">{organization.name}</span>
              );

              return (
                <li
                  class:list={[
                    'conference-partners__logo-item',
                    logo?.className && `conference-partners__logo-item--${logo.className}`,
                  ]}
                >
                  {organization.url ? (
                    <a href={organization.url} target="_blank" rel="noopener noreferrer">
                      {content}
                    </a>
                  ) : (
                    content
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <ul>
            {group.organizations.map((organization) => <li>{organization.name}</li>)}
          </ul>
        )}
      </section>
    ))}
  </div>
</section>
